<!-- MODAL POPUP LIHAT FOTO (LIGHTBOX TERPADU) -->
<div id="modalLihatFoto" style="display:none; position:fixed; z-index:99999; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.82); align-items:center; justify-content:center; padding:15px; box-sizing:border-box;">
  <div style="background:white; border-radius:12px; max-width:620px; width:100%; overflow:hidden; box-shadow:0 20px 40px rgba(0,0,0,0.4); display:flex; flex-direction:column; max-height:92vh; animation:fadeInModal 0.2s ease;">
    <!-- Modal Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid #e2e8f0; background:#f8fafc;">
      <strong id="modalFotoJudul" style="font-size:15px; color:#002255; display:flex; align-items:center; gap:8px;">
        <i class="fas fa-image" style="color:#003580;"></i> Bukti Foto Wajib Lapor
      </strong>
      <button type="button" onclick="tutupModalFoto()" style="background:none; border:none; font-size:24px; cursor:pointer; color:#64748b; line-height:1; padding:0 4px;">&times;</button>
    </div>
    
    <!-- Modal Body (Foto) -->
    <div style="padding:15px; text-align:center; overflow-y:auto; background:#0f172a; display:flex; align-items:center; justify-content:center; min-height:220px;">
      <img id="modalFotoSrc" src="" alt="Bukti Foto" style="max-width:100%; max-height:65vh; object-fit:contain; border-radius:6px; box-shadow:0 4px 14px rgba(0,0,0,0.35);" onerror="this.onerror=null; this.src='/logo_pemasyarakatan-removebg-preview.png';">
    </div>

    <!-- Modal Footer -->
    <div style="padding:12px 18px; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; gap:10px; background:#f8fafc; flex-wrap:wrap;">
      <button type="button" class="btn btn-primary" onclick="bukaLayarPenuh()" style="padding:8px 16px; font-size:13px; display:inline-flex; align-items:center; gap:6px; cursor:pointer;">
        <i class="fas fa-external-link-alt"></i> Buka Layar Penuh
      </button>
      <button type="button" class="btn btn-secondary" onclick="tutupModalFoto()" style="padding:8px 18px; font-size:13px; cursor:pointer;">
        <i class="fas fa-times"></i> Tutup
      </button>
    </div>
  </div>
</div>

<style>
@keyframes fadeInModal {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
</style>

<!-- MODAL RESET SANDI ADMINISTRATOR -->
<div id="modalResetAdmin" style="display:none; position:fixed; z-index:99999; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.65); align-items:center; justify-content:center; padding:15px; box-sizing:border-box;">
  <div style="background:white; border-radius:10px; max-width:440px; width:100%; overflow:hidden; box-shadow:0 20px 40px rgba(0,0,0,0.4); animation:fadeInModal 0.2s ease;">
    <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid #e2e8f0; background:#f8fafc;">
      <strong style="font-size:15px; color:#002255; display:flex; align-items:center; gap:8px;">
        <i class="fas fa-user-shield" style="color:#003580;"></i> Ganti Sandi Administrator
      </strong>
      <button type="button" onclick="tutupResetAdminModal()" style="background:none; border:none; font-size:24px; cursor:pointer; color:#64748b; line-height:1; padding:0 4px;">&times;</button>
    </div>
    <form action="/admin/reset-password" method="POST" autocomplete="off" style="padding:18px;">
      <div style="margin-bottom:16px;">
        <label for="adminNewPassword" style="display:block; font-weight:700; font-size:13px; color:#1e293b; margin-bottom:6px;">Kata Sandi Baru Admin *</label>
        <input 
          type="password" 
          name="new_password" 
          id="adminNewPassword" 
          required 
          minlength="5"
          placeholder="Masukkan kata sandi baru admin"
          style="width:100%; padding:10px 12px; border:1.5px solid #cbd5e1; border-radius:6px; font-size:14px; box-sizing:border-box;"
        >
        <small style="color:#64748b; font-size:11.5px; margin-top:4px; display:block;">Minimal 5 karakter. Sandi ini akan langsung aktif untuk login admin berikutnya.</small>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
        <button type="button" class="btn btn-secondary" onclick="tutupResetAdminModal()" style="padding:8px 14px; font-size:13px;">Batal</button>
        <button type="submit" class="btn btn-primary" style="padding:8px 16px; font-size:13px; font-weight:700; background:#003580;">
          <i class="fas fa-check"></i> Simpan Sandi Baru
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// Modal Ganti Sandi Administrator
function openResetAdminModal() {
  const m = document.getElementById('modalResetAdmin');
  if (m) {
    const input = document.getElementById('adminNewPassword');
    if (input) input.value = '';
    m.style.display = 'flex';
  }
}
function tutupResetAdminModal() {
  const m = document.getElementById('modalResetAdmin');
  if (m) m.style.display = 'none';
}

// Modal Bukti Foto (Lightbox)
function bukaModalFoto(srcUrl, namaKlien, periode) {
  const modal = document.getElementById('modalLihatFoto');
  const img = document.getElementById('modalFotoSrc');
  const judul = document.getElementById('modalFotoJudul');
  if (!modal || !img) return;

  if (!srcUrl) {
    srcUrl = '/logo_pemasyarakatan-removebg-preview.png';
  }

  img.src = srcUrl;
  if (judul) {
    judul.innerHTML = '<i class="fas fa-image" style="color:#003580;"></i> Foto Bukti: ' + (namaKlien || 'Klien') + (periode ? ' &bull; ' + periode : '');
  }
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function bukaLayarPenuh() {
  const img = document.getElementById('modalFotoSrc');
  if (!img || !img.src) return;
  const src = img.src;
  if (src.startsWith('data:')) {
    const w = window.open('');
    if (w) {
      w.document.write('<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Foto Bukti - BAPAS Medan</title><style>html,body{margin:0;padding:0;height:100%;background:#0b1120;display:flex;align-items:center;justify-content:center;}img{max-width:98vw;max-height:98vh;object-fit:contain;box-shadow:0 8px 30px rgba(0,0,0,0.5);border-radius:6px;}</style></head><body><img src="' + src + '"></body></html>');
      w.document.close();
    }
  } else {
    window.open(src, '_blank');
  }
}

function tutupModalFoto() {
  const modal = document.getElementById('modalLihatFoto');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}

window.addEventListener('click', function(e) {
  const modalFoto = document.getElementById('modalLihatFoto');
  if (modalFoto && e.target === modalFoto) {
    tutupModalFoto();
  }
  const modalReset = document.getElementById('modalResetAdmin');
  if (modalReset && e.target === modalReset) {
    tutupResetAdminModal();
  }
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    tutupModalFoto();
    tutupResetAdminModal();
  }
});

// AUTO LOGOUT ADMIN JIKA TIDAK ADA AKTIVITAS SELAMA 2 MENIT (Khusus Halaman Admin)
(function() {
  if (!window.location.pathname.startsWith('/admin')) return;

  const INACTIVITY_LIMIT_MS = 2 * 60 * 1000; // 2 Menit (120 detik)
  const WARNING_BEFORE_MS = 15 * 1000; // Peringatan 15 detik sebelum logout
  let lastActivityTime = Date.now();
  let warningShown = false;
  let countdownInterval = null;

  function resetActivity() {
    lastActivityTime = Date.now();
    if (warningShown) {
      warningShown = false;
      if (countdownInterval) clearInterval(countdownInterval);
      if (typeof Swal !== 'undefined' && Swal.isVisible()) {
        Swal.close();
      }
    }
  }

  // Pantau semua aktivitas pengguna (gerakan mouse, klik, ketik, sentuhan HP, scroll)
  ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll', 'click'].forEach(function(ev) {
    window.addEventListener(ev, resetActivity, { passive: true });
  });

  // Evaluasi aktivitas setiap 1 detik
  setInterval(function() {
    const idleTime = Date.now() - lastActivityTime;

    // Tampilkan peringatan saat tersisa 15 detik
    if (idleTime >= (INACTIVITY_LIMIT_MS - WARNING_BEFORE_MS) && !warningShown) {
      warningShown = true;
      let sisaDetik = Math.max(1, Math.round((INACTIVITY_LIMIT_MS - idleTime) / 1000));
      
      if (typeof Swal !== 'undefined') {
        Swal.fire({
          title: 'Sesi Admin Segera Berakhir!',
          html: 'Tidak ada aktivitas terdeteksi.<br>Sistem akan melakukan logout otomatis dalam <b><span id="countdownLogoutText" style="color:#e11d48; font-size:18px;">' + sisaDetik + '</span></b> detik demi keamanan.',
          icon: 'warning',
          showConfirmButton: true,
          confirmButtonText: '<i class="fas fa-check-circle"></i> Saya Masih Bekerja (Lanjutkan Sesi)',
          confirmButtonColor: '#003580',
          allowOutsideClick: false,
          timer: sisaDetik * 1000,
          timerProgressBar: true
        }).then(function(result) {
          if (result.isConfirmed) {
            resetActivity();
          }
        });

        countdownInterval = setInterval(function() {
          sisaDetik--;
          const el = document.getElementById('countdownLogoutText');
          if (el) el.innerText = Math.max(0, sisaDetik);
          if (sisaDetik <= 0) clearInterval(countdownInterval);
        }, 1000);
      }
    }

    // Logout paksa saat mencapai 2 menit tanpa aktivitas
    if (idleTime >= INACTIVITY_LIMIT_MS) {
      window.location.href = '/logout?tipe=admin&pesan=timeout';
    }
  }, 1000);
})();
</script>
