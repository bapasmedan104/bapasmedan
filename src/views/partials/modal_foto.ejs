<!-- MODAL POPUP LIHAT FOTO (LIGHTBOX TERPADU) -->
<div id="modalLihatFoto" style="display:none; position:fixed; z-index:99999; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.82); align-items:center; justify-content:center; padding:15px; box-sizing:border-box;">
  <div style="background:white; border-radius:12px; max-width:620px; width:100%; overflow:hidden; box-shadow:0 20px 40px rgba(0,0,0,0.4); display:flex; flex-direction:column; max-height:92vh; animation:fadeInModal 0.2s ease;">
    <!-- Modal Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid #e2e8f0; background:#f8fafc;">
      <strong id="modalFotoJudul" style="font-size:15px; color:#002255; display:flex; align-items:center; gap:8px;">
        <i class="fas fa-image" style="color:#003580;"></i> Bukti Foto Wajib Lapor
      </strong>
      <button type="button" onclick="tutupModalFoto()" style="background:none; border:none; font-size:24px; cursor:pointer; color:#64748b; line-height:1; padding:0 4px;">&times;</button>
    </div>
    
    <!-- Modal Body (Foto) -->
    <div style="padding:15px; text-align:center; overflow-y:auto; background:#0f172a; display:flex; align-items:center; justify-content:center; min-height:220px;">
      <img id="modalFotoSrc" src="" alt="Bukti Foto" style="max-width:100%; max-height:65vh; object-fit:contain; border-radius:6px; box-shadow:0 4px 14px rgba(0,0,0,0.35);" onerror="this.onerror=null; this.src='/logo_pemasyarakatan-removebg-preview.png';">
    </div>

    <!-- Modal Footer -->
    <div style="padding:12px 18px; border-top:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; gap:10px; background:#f8fafc; flex-wrap:wrap;">
      <a id="modalFotoDownload" href="#" target="_blank" class="btn btn-primary" style="padding:8px 16px; font-size:13px; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
        <i class="fas fa-external-link-alt"></i> Buka Layar Penuh
      </a>
      <button type="button" class="btn btn-secondary" onclick="tutupModalFoto()" style="padding:8px 18px; font-size:13px;">
        <i class="fas fa-times"></i> Tutup
      </button>
    </div>
  </div>
</div>

<style>
@keyframes fadeInModal {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
</style>

<script>
function bukaModalFoto(srcUrl, namaKlien, periode) {
  const modal = document.getElementById('modalLihatFoto');
  const img = document.getElementById('modalFotoSrc');
  const judul = document.getElementById('modalFotoJudul');
  const downloadLink = document.getElementById('modalFotoDownload');
  if (!modal || !img) return;

  img.src = srcUrl;
  if (judul) {
    judul.innerHTML = '<i class="fas fa-image" style="color:#003580;"></i> Foto Bukti: ' + (namaKlien || 'Klien') + (periode ? ' &bull; ' + periode : '');
  }
  if (downloadLink) {
    downloadLink.href = srcUrl;
  }
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function tutupModalFoto() {
  const modal = document.getElementById('modalLihatFoto');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}

window.addEventListener('click', function(e) {
  const modal = document.getElementById('modalLihatFoto');
  if (modal && e.target === modal) {
    tutupModalFoto();
  }
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    tutupModalFoto();
  }
});
</script>
