<!-- TOPBAR RESMI INSTANSI -->
<div class="topbar">
  <div class="container" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <div class="topbar-left" style="display:flex; align-items:center; gap:16px; font-size:12px;">
      <span><i class="fas fa-flag" style="color:var(--gold);"></i> Republik Indonesia</span>
      <span class="d-none-sm"><i class="fas fa-balance-scale" style="color:var(--gold);"></i> Zona Integritas WBK / WBBM</span>
      <span class="topbar-hide-md"><i class="fas fa-clock" style="color:var(--gold);"></i> Pelayanan: Senin - Jumat 08:00 - 16:00 WIB</span>
    </div>
    <div class="topbar-right" style="display:flex; align-items:center; gap:14px; font-size:12px;">
      <a href="tel:0614516516" style="color:rgba(255,255,255,0.85); text-decoration:none; display:inline-flex; align-items:center; gap:5px;"><i class="fas fa-phone-alt" style="color:var(--gold);"></i> (061) 4516516</a>
      <a href="/login" class="btn-login-top"><i class="fas fa-clipboard-check"></i> Wajib Lapor Klien</a>
    </div>
  </div>
</div>

<!-- HEADER UTAMA -->
<header class="header">
