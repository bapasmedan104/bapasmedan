<script>
  function toggleMobileNav(e) {
    if (e) {
      if (typeof e.preventDefault === 'function') e.preventDefault();
      if (typeof e.stopPropagation === 'function') e.stopPropagation();
    }
    var menu = document.getElementById('navMenu');
    var btn = document.getElementById('hamburger');
    var label = document.getElementById('hamburgerLabel');
    var icon = document.getElementById('hamburgerIcon');
    if (!menu) return;

    var isOpen = menu.classList.toggle('open');
    if (btn) btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (label) label.textContent = isOpen ? 'Tutup' : 'Menu';
    if (icon) {
      icon.className = isOpen ? 'fas fa-times' : 'fas fa-bars';
    }

    if (isOpen) {
      menu.style.top = '54px';
      menu.style.height = 'calc(100vh - 54px)';
      menu.style.maxHeight = 'calc(100vh - 54px)';
      menu.style.setProperty('display', 'flex', 'important');
      menu.style.setProperty('visibility', 'visible', 'important');
      menu.style.setProperty('opacity', '1', 'important');
      menu.style.setProperty('pointer-events', 'auto', 'important');
    } else {
      menu.style.removeProperty('display');
      menu.style.removeProperty('visibility');
      menu.style.removeProperty('opacity');
      menu.style.removeProperty('height');
      menu.style.removeProperty('max-height');
      menu.style.removeProperty('pointer-events');
    }
  }
  window.toggleMobileNav = toggleMobileNav;

  // Handle dropdown toggle & click outside
  (function() {
    function initNavActions() {
      // Handle dropdown toggle on mobile
      var dropdownLinks = document.querySelectorAll('.has-dropdown > a');
      dropdownLinks.forEach(function(link) {
        link.onclick = function(e) {
          if (window.innerWidth <= 992) {
            if (e) {
              if (typeof e.preventDefault === 'function') e.preventDefault();
              if (typeof e.stopPropagation === 'function') e.stopPropagation();
            }
            var li = this.closest('.has-dropdown') || this.parentElement;
            if (li) {
              var isOpen = li.classList.toggle('active-dropdown');
              var dd = li.querySelector('.dropdown');
              if (dd) {
                dd.style.setProperty('display', isOpen ? 'block' : 'none', 'important');
              }
              var arrow = this.querySelector('i.arrow');
              if (arrow) {
                arrow.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
              }
            }
            return false;
          }
        };
      });

      // Allow navigation and close menu when regular links are clicked
      var navLinks = document.querySelectorAll('#navMenu a:not(.has-dropdown > a)');
      navLinks.forEach(function(link) {
        link.addEventListener('click', function() {
          var menu = document.getElementById('navMenu');
          if (menu && menu.classList.contains('open')) {
            toggleMobileNav();
          }
        });
      });

      // Handle click outside to close menu
      document.addEventListener('click', function(e) {
        var menu = document.getElementById('navMenu');
        var btn = document.getElementById('hamburger');
        if (menu && menu.classList.contains('open')) {
          if (!menu.contains(e.target) && !btn.contains(e.target)) {
            toggleMobileNav();
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavActions);
    } else {
      initNavActions();
    }
  })();
</script>

