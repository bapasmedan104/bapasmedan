    <div class="header-logo">
      <div style="display:flex; align-items:center; gap:14px; flex-shrink:0;">
        <img src="/logo_kemenimpas-removebg-preview.png" alt="Lambang Kementerian Imigrasi dan Pemasyarakatan" style="height:62px; filter:drop-shadow(0 2px 6px rgba(0,0,0,0.3));" onerror="this.style.display='none'">
        <img src="/logo_pemasyarakatan_custom.png?v=2" alt="Logo Pemasyarakatan Balai Pemasyarakatan Kelas I Medan" style="height:62px; filter:drop-shadow(0 2px 6px rgba(0,0,0,0.3));" onerror="this.src='/logo_pemasyarakatan-removebg-preview.png'">
      </div>
      <div>
        <span class="header-sub">
          KEMENTERIAN IMIGRASI DAN PEMASYARAKATAN REPUBLIK INDONESIA
        </span>
        <h1 class="header-main">
          BALAI PEMASYARAKATAN KELAS I MEDAN
        </h1>
        <span class="header-tagline">
          Kantor Wilayah Sumatera Utara &bull; Menuju Wilayah Bebas dari Korupsi (WBK)
        </span>
      </div>
    </div>
    <div class="header-contact">
      <i class="fas fa-envelope-open-text"></i>
      <div>
        <span class="contact-label">Layanan Informasi Resmi</span>
        <span class="contact-value">bapasmedan@kemenkumham.go.id</span>
      </div>
    </div>
  </div>
</header>

