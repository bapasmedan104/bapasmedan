<!-- =======================================================
     WIDGET PUSAT BANTUAN TERPADU BAPAS KELAS I MEDAN (LAYAR PENUH)
     Memiliki 2 Kategori:
     1. Langkah-Langkah Bantuan (Panduan Lengkap & Interaktif)
     2. Customer Service Real-Time (Live Chat BAPAS Tanpa WhatsApp)
     ======================================================= -->

<!-- TOMBOL FLOATING PUSAT BANTUAN -->
<div id="btnPusatBantuanFloating" class="btn-pusat-bantuan-floating" onclick="bukaPusatBantuan()" title="Buka Pusat Bantuan & Customer Service">
  <div class="pulse-online-badge"></div>
  <i class="fas fa-headset"></i>
  <span class="btn-bantuan-text">Pusat Bantuan</span>
</div>

<!-- CONTAINER LAYAR PENUH PUSAT BANTUAN -->
<div id="modalPusatBantuan" class="fullscreen-bantuan-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="bantuanModalTitle">
  <div class="fullscreen-bantuan-wrapper">
    
    <!-- Top Header Bar -->
    <header class="fullscreen-bantuan-header">
      <div class="header-brand-wrap">
        <div style="display:flex; align-items:center; gap:10px;">
          <img src="/logo_kemenimpas-removebg-preview.png" alt="Logo Kemenimipas" class="header-logo-img" onerror="this.style.display='none'">
          <img src="/logo_pemasyarakatan_custom.png?v=2" alt="Logo Pemasyarakatan" class="header-logo-img" onerror="this.src='/logo_pemasyarakatan-removebg-preview.png'">
        </div>
        <div>
          <h2 id="bantuanModalTitle" class="header-title-text">
            <i class="fas fa-life-ring" style="color:#f59e0b;"></i> Pusat Bantuan & Layanan
          </h2>
          <span class="header-subtitle-text">Balai Pemasyarakatan (BAPAS) Kelas I Medan &bull; Kemenimipas RI</span>
        </div>
      </div>

      <button type="button" class="btn-close-fullscreen" onclick="tutupPusatBantuan()" aria-label="Tutup Pusat Bantuan">
        <i class="fas fa-times"></i>
        <span class="btn-close-label">Tutup</span>
      </button>
    </header>

    <!-- Navigation Tabs (2 Kategori) -->
    <nav class="bantuan-tabs-nav" aria-label="Pilihan Kategori Bantuan">
      <button type="button" id="tabHeadLangkah" class="bantuan-tab-btn active" onclick="switchKategoriBantuan('langkah')">
        <i class="fas fa-book-reader"></i>
        <span>1. Langkah-Langkah Bantuan</span>
      </button>
      <button type="button" id="tabHeadCS" class="bantuan-tab-btn" onclick="switchKategoriBantuan('cs')">
        <div class="cs-indicator-dot"></div>
        <i class="fas fa-comments"></i>
        <span>2. Customer Service Real-Time</span>
      </button>
    </nav>

    <!-- Main Content Area -->
    <main class="fullscreen-bantuan-content">
      
      <!-- ==============================================
           KATEGORI 1: LANGKAH-LANGKAH BANTUAN (PANDUAN)
           ============================================== -->
      <section id="kategoriLangkah" class="kategori-pane active" aria-labelledby="tabHeadLangkah">
        <div class="kategori-inner-container">
          
          <div class="banner-panduan-info">
            <i class="fas fa-info-circle banner-info-icon"></i>
            <div>
              <strong>Panduan Interaktif Pelayanan Wajib Lapor Online</strong>
              <p style="margin:2px 0 0; font-size:12.5px; color:#166534;">
                Pilih topik panduan di bawah untuk melihat solusi langkah demi langkah penggunaan sistem wajib lapor.
              </p>
            </div>
          </div>

          <!-- Accordion Group -->
          <div class="faq-accordion-group">
            
            <!-- Langkah 1: Login -->
            <details class="bantuan-item" open>
              <summary>
                <span><i class="fas fa-sign-in-alt text-primary"></i> Langkah 1: Cara Masuk / Login ke Akun Klien</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
              </summary>
              <div class="bantuan-content">
                <p>Untuk masuk ke portal wajib lapor online BAPAS Kelas I Medan:</p>
                <ol>
                  <li>Kunjungi tautan masuk resmi di <a href="/login" style="color:#003580; font-weight:700;">bapas1medan.com/login</a>.</li>
                  <li>Masukkan <strong>Nomor WhatsApp</strong> aktif atau <strong>Nomor Register Klien</strong> yang tercatat di Surat Keputusan (contoh: <code>REG-2026</code>).</li>
                  <li>Masukkan Kata Sandi akun Anda yang telah didaftarkan oleh Pembimbing Kemasyarakatan (PK).</li>
                  <li>Selesaikan verifikasi keamanan Cloudflare Turnstile, lalu klik tombol <strong>Masuk ke Portal Klien</strong>.</li>
                </ol>
                <div class="note-tips">
                  <i class="fas fa-lightbulb" style="color:#d97706;"></i>
                  <span>Jika mengalami kendala kata sandi atau akun belum aktif, Anda dapat langsung mengirim pesan di tab <strong>2. Customer Service Real-Time</strong>.</span>
                </div>
              </div>
            </details>

            <!-- Langkah 2: Jadwal Wajib Lapor -->
            <details class="bantuan-item">
              <summary>
                <span><i class="fas fa-calendar-alt text-primary"></i> Langkah 2: Jadwal & Waktu Wajib Lapor Dibuka</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
              </summary>
              <div class="bantuan-content">
                <div class="jadwal-badge-box">
                  <strong style="color:#002255; font-size:13.5px; display:block; margin-bottom:4px;">
                    <i class="fas fa-bullhorn" style="color:#003580;"></i> Jadwal Resmi Berdasarkan Sistem:
                  </strong>
                  <span style="color:#1e293b; font-size:13px; font-weight:600;">
                    <% if (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.teks_pengumuman) { %>
                      <%= konfigurasi.teks_pengumuman %>
                    <% } else { %>
                      Layanan dibuka setiap tanggal <strong><%= (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.tanggal_mulai_input) ? konfigurasi.tanggal_mulai_input : 1 %> s/d <%= (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.tanggal_akhir_input) ? konfigurasi.tanggal_akhir_input : 15 %> setiap bulannya</strong>.
                    <% } %>
                  </span>
                </div>
                <p>Klien diwajibkan melapor tepat waktu di dalam rentang tanggal tersebut. Di luar tanggal ini, sistem pelaporan daring ditutup secara otomatis untuk proses evaluasi dan audit pembimbingan.</p>
              </div>
            </details>

            <!-- Langkah 3: Profil Klien -->
            <details class="bantuan-item">
              <summary>
                <span><i class="fas fa-user-edit text-primary"></i> Langkah 3: Melengkapi Profil & Masa Wajib Lapor Otomatis</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
              </summary>
              <div class="bantuan-content">
                <ol>
                  <li>Sebelum membuat laporan pertama, periksa dan perbarui data profil Anda melalui menu <strong>Profil Klien</strong>.</li>
                  <li>Lengkapi Nama Lengkap sesuai KTP, Nomor WhatsApp Aktif, dan Alamat Domisili tinggal saat ini.</li>
                  <li>Kolom <strong>Masa / Periode Wajib Lapor</strong> kini terisi secara <strong>otomatis</strong> sesuai tanggal SK bimbingan yang telah ditetapkan oleh admin BAPAS, sehingga Anda tidak perlu menghitung atau mengisi manual.</li>
                  <li>Klik tombol <strong>Simpan & Perbarui Profil</strong>.</li>
                </ol>
              </div>
            </details>

            <!-- Langkah 4: Kamera & Bukti Presensi -->
            <details class="bantuan-item">
              <summary>
                <span><i class="fas fa-camera text-primary"></i> Langkah 4: Pengambilan Foto Bukti via Kamera (Depan & Belakang)</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
              </summary>
              <div class="bantuan-content">
                <p>Demi keaslian dan keabsahan presensi kehadiran bimbingan kemasyarakatan, foto bukti wajib lapor diambil langsung melalui kamera ponsel:</p>
                <ul>
                  <li><strong>Ambil Foto dengan Kamera:</strong> Klik tombol "Buka Kamera". Sistem menyediakan tombol putar kamera untuk berganti antara <em>Kamera Depan (Swafoto/Selfie)</em> dan <em>Kamera Belakang</em> ponsel Anda. Klik "Ambil Foto" saat posisi wajah Anda telah pas dan jelas.</li>
                  <li><strong>Keaslian Presensi:</strong> Pengambilan foto langsung dari kamera memastikan kehadiran nyata klien binaan saat pelaporan rutin bulanan.</li>
                  <li>Pastikan wajah terlihat jelas, pencahayaan cukup, serta tidak mengenakan kacamata hitam tebal atau penutup wajah.</li>
                </ul>
              </div>
            </details>

            <!-- Langkah 5: GPS & Izin Lokasi -->
            <details class="bantuan-item">
              <summary>
                <span><i class="fas fa-map-marker-alt text-primary"></i> Langkah 5: Mengatasi Kendala Lokasi GPS</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
              </summary>
              <div class="bantuan-content">
                <p>Sistem mewajibkan deteksi titik koordinat presensi yang sah demi keabsahan laporan:</p>
                <ul>
                  <li>Saat browser ponsel menampilkan permintaan izin lokasi (<em>Location Permission</em>), pilih <strong>Izinkan / Allow</strong>.</li>
                  <li>Pastikan GPS pada ponsel Android/iPhone dalam kondisi Aktif (Akurasi Tinggi).</li>
                  <li><strong>Peringatan Tegas:</strong> Sistem BAPAS Medan secara otomatis mendeteksi dan menolak laporan yang menggunakan aplikasi lokasi palsu (Fake GPS / Mock Location).</li>
                </ul>
              </div>
            </details>

            <!-- Langkah 6: Laporan Ditolak -->
            <details class="bantuan-item">
              <summary>
                <span><i class="fas fa-exclamation-circle text-primary"></i> Langkah 6: Jika Laporan Ditolak oleh Petugas Pembimbing</span>
                <i class="fas fa-chevron-down arrow-icon"></i>
              </summary>
              <div class="bantuan-content">
                <p>Apabila laporan Anda berstatus <strong>Ditolak</strong>:</p>
                <ul>
                  <li>Buka menu <strong>Riwayat Lapor</strong> pada dashboard klien.</li>
                  <li>Pada tabel riwayat lapor yang berstatus ditolak, periksa <strong>Catatan / Alasan Penolakan</strong> dari petugas PK (contoh: foto buram atau deskripsi pekerjaan belum lengkap).</li>
                  <li>Segera lakukan perbaikan dan kirimkan laporan revisi sebelum tanggal penutupan wajib lapor bulan berjalan.</li>
                </ul>
              </div>
            </details>

          </div>
        </div>
      </section>

      <!-- ==============================================
           KATEGORI 2: CUSTOMER SERVICE REAL-TIME (LIVE CHAT RESMI)
           TANPA WHATSAPP - SEPENUHNYA IN-APP REAL-TIME
           DENGAN PILIHAN: SUDAH / BELUM PUNYA NO. REGISTRASI
           ============================================== -->
      <section id="kategoriCS" class="kategori-pane" aria-labelledby="tabHeadCS">
        <div class="cs-full-container">
          
          <!-- CS Status Header Bar -->
          <div class="cs-status-bar">
            <div class="cs-status-info">
              <div class="pulse-green-dot"></div>
              <div>
                <strong style="font-size:13.5px; color:#065f46; display:block;">Customer Service Resmi BAPAS Medan</strong>
                <span style="font-size:12px; color:#047857;" id="csStatusSubtitle">Layanan Percakapan Interaktif Real-Time</span>
              </div>
            </div>
            <div class="cs-status-actions">
              <div id="csIdentityPill" class="cs-identity-pill" style="display:none;"></div>
              <button type="button" id="btnGantiIdentitasCS" class="btn-ganti-identitas" onclick="resetCsSession()" title="Ganti identitas atau nomor registrasi obrolan" style="display:none;">
                <i class="fas fa-sync-alt"></i> Ganti Identitas
              </button>
              <div class="cs-badge-secure">
                <i class="fas fa-shield-alt"></i> Obrolan Resmi
              </div>
            </div>
          </div>

          <!-- CONTAINER 1: PILIHAN SEBELUM CHAT (PRE-CHAT SELECTION) -->
          <div id="csPrechatContainer" class="cs-prechat-screen">
            <div class="prechat-hero-banner">
              <div class="prechat-banner-icon">
                <i class="fas fa-comments"></i>
              </div>
              <div class="prechat-banner-text">
                <h3 class="prechat-banner-title">Mulai Percakapan dengan Customer Service</h3>
                <p class="prechat-banner-desc">
                  Silakan pilih opsi identitas di bawah ini agar petugas BAPAS Kelas I Medan dapat memberikan respon dan data informasi yang akurat.
                </p>
              </div>
            </div>

            <!-- DUA PILIHAN KARTU -->
            <div class="prechat-cards-grid">
              <!-- Pilihan 1: Sudah Punya Nomor Registrasi -->
              <div class="prechat-option-card active" id="cardOptRegister" onclick="selectCsOption('registered')">
                <div class="prechat-opt-header">
                  <div class="prechat-opt-icon icon-reg">
                    <i class="fas fa-id-card"></i>
                  </div>
                  <div>
                    <span class="prechat-opt-tag tag-reg"><i class="fas fa-check-circle"></i> Klien Binaan</span>
                    <h4 class="prechat-opt-title">Sudah Punya Nomor Registrasi</h4>
                  </div>
                </div>
                <p class="prechat-opt-text">
                  Khusus Klien Binaan BAPAS Medan (PB, CB, CMB, Asimilasi). Sistem akan memverifikasi data Anda secara otomatis dan mengirim detail binaan ke percakapan.
                </p>
                <div class="prechat-opt-select-indicator">
                  <i class="fas fa-check"></i> Pilihan Aktif
                </div>
              </div>

              <!-- Pilihan 2: Belum Punya Nomor Registrasi -->
              <div class="prechat-option-card" id="cardOptGuest" onclick="selectCsOption('guest')">
                <div class="prechat-opt-header">
                  <div class="prechat-opt-icon icon-guest">
                    <i class="fas fa-user-friends"></i>
                  </div>
                  <div>
                    <span class="prechat-opt-tag tag-guest"><i class="fas fa-user"></i> Pengunjung / Umum</span>
                    <h4 class="prechat-opt-title">Belum Punya Nomor Registrasi</h4>
                  </div>
                </div>
                <p class="prechat-opt-text">
                  Untuk Masyarakat umum, keluarga klien, penjamin, atau pengunjung baru. Cukup isi nama Anda untuk langsung terhubung dengan Customer Service.
                </p>
                <div class="prechat-opt-select-indicator">
                  <i class="fas fa-check"></i> Pilihan Aktif
                </div>
              </div>
            </div>

            <!-- FORM PANEL 1: SUDAH PUNYA NOMOR REGISTRASI -->
            <div id="panelFormRegister" class="prechat-form-box">
              <div class="prechat-form-header">
                <i class="fas fa-shield-alt text-reg-icon"></i>
                <div>
                  <strong>Verifikasi Nomor Registrasi Klien</strong>
                  <p>Ketik nomor registrasi Anda (contoh: REG-2026). Sistem akan mendeteksi data registrasi Anda secara instan.</p>
                </div>
              </div>

              <div class="prechat-input-group">
                <label for="inputCsNoRegister" class="prechat-label">
                  Nomor Registrasi Klien <span style="color:#ef4444;">*</span>
                </label>
                <div class="prechat-input-action-row">
                  <div class="prechat-input-wrapper">
                    <i class="fas fa-id-badge input-icon"></i>
                    <input 
                      type="text" 
                      id="inputCsNoRegister" 
                      class="prechat-text-input" 
                      placeholder="Masukkan No. Register (contoh: REG-2026)" 
                      autocomplete="off"
                      onkeydown="if(event.key==='Enter'){ event.preventDefault(); verifikasiNoRegister(); }"
                    >
                  </div>
                  <button type="button" id="btnCekRegister" class="btn-prechat-action" onclick="verifikasiNoRegister()">
                    <i class="fas fa-search"></i> <span>Periksa Data</span>
                  </button>
                </div>
                <span class="prechat-help-text">
                  <i class="fas fa-info-circle"></i> Nomor registrasi tertera pada surat keputusan (SK) atau buku register bimbingan Anda.
                </span>
              </div>

              <!-- Alert Not Found / Error -->
              <div id="alertRegisterError" class="prechat-alert-error" style="display:none;"></div>

              <!-- Preview Card Hasil Verifikasi Database -->
              <div id="previewRegisterSuccess" class="prechat-verified-preview" style="display:none;">
                <div class="verified-card-top">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-check-circle" style="color:#10b981; font-size:18px;"></i>
                    <strong style="color:#065f46; font-size:14px;">Data Registrasi Klien Berhasil Ditemukan!</strong>
                  </div>
                  <span class="badge-terverifikasi"><i class="fas fa-database"></i> TERVERIFIKASI RESMI</span>
                </div>
                <div class="verified-card-body" id="previewRegisterDetails"></div>
                <div style="margin-top:14px; text-align:right;">
                  <button type="button" id="btnConfirmRegisterChat" class="btn-confirm-chat" onclick="mulaiChatTerverifikasi()">
                    <i class="fas fa-comments"></i> Hubungkan ke Customer Service Sekarang
                  </button>
                </div>
              </div>
            </div>

            <!-- FORM PANEL 2: BELUM PUNYA NOMOR REGISTRASI -->
            <div id="panelFormGuest" class="prechat-form-box" style="display:none;">
              <div class="prechat-form-header">
                <i class="fas fa-user-circle text-guest-icon"></i>
                <div>
                  <strong>Identitas Pengunjung / Masyarakat Umum</strong>
                  <p>Masukkan Nama Lengkap Anda sebelum membuka obrolan langsung dengan Customer Service.</p>
                </div>
              </div>

              <div class="prechat-guest-grid">
                <div class="prechat-input-group">
                  <label for="inputCsNamaGuest" class="prechat-label">
                    Nama Lengkap Anda <span style="color:#ef4444;">*</span>
                  </label>
                  <div class="prechat-input-wrapper">
                    <i class="fas fa-user input-icon"></i>
                    <input 
                      type="text" 
                      id="inputCsNamaGuest" 
                      class="prechat-text-input" 
                      placeholder="Ketik Nama Lengkap Anda *" 
                      autocomplete="name"
                      onkeydown="if(event.key==='Enter'){ event.preventDefault(); mulaiChatPengunjung(); }"
                    >
                  </div>
                </div>

                <div class="prechat-input-group">
                  <label for="inputCsKontakGuest" class="prechat-label">
                    Nomor WhatsApp / HP (Opsional)
                  </label>
                  <div class="prechat-input-wrapper">
                    <i class="fas fa-phone-alt input-icon"></i>
                    <input 
                      type="text" 
                      id="inputCsKontakGuest" 
                      class="prechat-text-input" 
                      placeholder="Contoh: 08123456789 (opsional)" 
                      autocomplete="tel"
                      onkeydown="if(event.key==='Enter'){ event.preventDefault(); mulaiChatPengunjung(); }"
                    >
                  </div>
                </div>
              </div>

              <div id="alertGuestError" class="prechat-alert-error" style="display:none;"></div>

              <div style="margin-top:16px; text-align:right;">
                <button type="button" id="btnMulaiGuestChat" class="btn-confirm-chat btn-guest-confirm" onclick="mulaiChatPengunjung()">
                  <i class="fas fa-comments"></i> Mulai Percakapan Customer Service
                </button>
              </div>
            </div>

          </div>

          <!-- CONTAINER 2: RUANG PERCAKAPAN AKTIF (ACTIVE CHAT CONVERSATION) -->
          <div id="csChatActiveContainer" class="cs-active-chat-wrapper" style="display:none;">
            <!-- Chat Stream Messages Box -->
            <div id="chatStreamBox" class="cs-chat-stream" role="log" aria-live="polite">
              <div class="chat-msg chat-msg-bot">
                <div class="chat-avatar"><i class="fas fa-user-shield"></i></div>
                <div class="chat-bubble">
                  <div class="chat-sender-name">Asisten Layanan BAPAS:</div>
                  <p class="chat-text">Halo! Selamat datang di Customer Service Resmi BAPAS Kelas I Medan. Silakan tuliskan kendala login, pertanyaan wajib lapor, atau permohonan informasi Anda di bawah ini. Petugas kami siap merespons secara real-time.</p>
                  <span class="chat-time">Respon Otomatis</span>
                </div>
              </div>
            </div>

            <!-- Bottom Chat Input Bar -->
            <footer class="cs-bottom-bar">
              <form id="formKirimBantuanCS" class="cs-form-wrap" onsubmit="handleKirimPesanCS(event)">
                <div class="cs-input-action-row">
                  <input 
                    type="text" 
                    id="csInputPesan" 
                    placeholder="Ketik pesan atau pertanyaan bantuan Anda di sini..." 
                    required 
                    class="cs-main-input"
                    autocomplete="off"
                  >
                  <button type="submit" id="btnKirimCS" class="cs-btn-send" aria-label="Kirim Pesan Bantuan">
                    <i class="fas fa-paper-plane"></i>
                    <span class="btn-send-label">Kirim</span>
                  </button>
                </div>
                <div class="cs-security-footnote">
                  <i class="fas fa-lock" style="color:#0284c7;"></i>
                  <span>Percakapan tersimpan aman di server BAPAS Kelas I Medan &amp; terhubung langsung ke panel petugas.</span>
                </div>
              </form>
            </footer>
          </div>

        </div>
      </section>

    </main>

  </div>
</div>

<!-- ==============================================
     STYLING PUSAT BANTUAN (RESPONSIF & LAYAR PENUH)
     ============================================== -->
<style>
/* Floating Trigger Button */
.btn-pusat-bantuan-floating {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 99990;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #001e4d 0%, #003580 100%);
  color: #ffffff;
  border: 2px solid #f59e0b;
  border-radius: 50px;
  padding: 12px 20px;
  cursor: pointer;
  box-shadow: 0 8px 25px rgba(0, 30, 80, 0.45);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: inherit;
}
.btn-pusat-bantuan-floating:hover {
  transform: translateY(-3px) scale(1.02);
  background: linear-gradient(135deg, #002b66 0%, #0045a5 100%);
  box-shadow: 0 12px 30px rgba(0, 30, 80, 0.6);
}
.btn-pusat-bantuan-floating i {
  font-size: 19px;
  color: #f59e0b;
}
.btn-bantuan-text {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.3px;
  color: #ffffff;
}
.pulse-online-badge {
  width: 10px;
  height: 10px;
  background: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  animation: pulseGreenGlow 1.8s infinite;
}
@keyframes pulseGreenGlow {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 9px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

/* FULLSCREEN OVERLAY & WRAPPER */
.fullscreen-bantuan-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  height: 100vh;
  background: #f8fafc;
  z-index: 999999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  animation: fadeInFullscreen 0.22s ease-out;
}
@keyframes fadeInFullscreen {
  from { opacity: 0; transform: scale(0.99); }
  to { opacity: 1; transform: scale(1); }
}

.fullscreen-bantuan-wrapper {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #f8fafc;
}

/* Header */
.fullscreen-bantuan-header {
  background: linear-gradient(135deg, #001938 0%, #002b66 100%);
  color: #ffffff;
  padding: 14px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 3px solid #f59e0b;
  flex-shrink: 0;
  box-shadow: 0 3px 12px rgba(0,0,0,0.15);
}
.header-brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}
.header-logo-img {
  height: 42px;
  width: auto;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
}
.header-title-text {
  margin: 0;
  font-size: 19px;
  color: #ffffff;
  font-family: 'Playfair Display', serif;
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
}
.header-subtitle-text {
  font-size: 12px;
  color: #fde68a;
  display: block;
  margin-top: 2px;
  font-weight: 600;
}

.btn-close-fullscreen {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #ffffff;
  font-size: 13.5px;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: 30px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
  font-family: inherit;
}
.btn-close-fullscreen:hover {
  background: #dc2626;
  border-color: #dc2626;
  color: #ffffff;
  transform: translateY(-1px);
}
.btn-close-fullscreen i {
  font-size: 15px;
}

/* Tabs Navigation */
.bantuan-tabs-nav {
  display: flex;
  background: #ffffff;
  border-bottom: 2px solid #e2e8f0;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(0,0,0,0.03);
}
.bantuan-tab-btn {
  flex: 1;
  padding: 14px 20px;
  border: none;
  background: transparent;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  color: #64748b;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: all 0.2s ease;
  border-bottom: 3px solid transparent;
}
.bantuan-tab-btn:hover {
  color: #003580;
  background: #f8fafc;
}
.bantuan-tab-btn.active {
  color: #003580;
  border-bottom-color: #003580;
  background: #ffffff;
}
.cs-indicator-dot {
  width: 9px;
  height: 9px;
  background: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
}

/* Content Area */
.fullscreen-bantuan-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  background: #f8fafc;
}
.kategori-pane {
  display: none;
  width: 100%;
  height: 100%;
  flex-direction: column;
}
.kategori-pane.active {
  display: flex;
}

/* Kategori 1: Langkah-Langkah Panduan */
.kategori-inner-container {
  max-width: 900px;
  width: 100%;
  margin: 0 auto;
  padding: 24px 20px 40px;
  overflow-y: auto;
  box-sizing: border-box;
  flex: 1;
}
.banner-panduan-info {
  margin-bottom: 18px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-left: 5px solid #16a34a;
  padding: 14px 18px;
  border-radius: 0 10px 10px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #166534;
}
.banner-info-icon {
  font-size: 24px;
  color: #16a34a;
  flex-shrink: 0;
}
.faq-accordion-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.bantuan-item {
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  transition: all 0.2s ease;
}
.bantuan-item summary {
  padding: 15px 18px;
  font-weight: 700;
  font-size: 14.5px;
  color: #1e293b;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.2s;
}
.bantuan-item summary::-webkit-details-marker {
  display: none;
}
.bantuan-item summary:hover {
  background: #f1f5f9;
}
.bantuan-item[open] summary {
  background: #eff6ff;
  color: #003580;
  border-bottom: 1px solid #bfdbfe;
}
.arrow-icon {
  font-size: 13px;
  color: #64748b;
  transition: transform 0.25s ease;
}
.bantuan-item[open] .arrow-icon {
  transform: rotate(180deg);
  color: #003580;
}
.bantuan-content {
  padding: 18px 22px;
  font-size: 14px;
  line-height: 1.75;
  color: #334155;
  background: #ffffff;
}
.bantuan-content ol, .bantuan-content ul {
  padding-left: 22px;
  margin: 10px 0;
}
.bantuan-content li {
  margin-bottom: 6px;
}
.note-tips {
  margin-top: 12px;
  background: #fefce8;
  border: 1px solid #fef08a;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  color: #854d0e;
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.jadwal-badge-box {
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-left: 4px solid #003580;
  padding: 12px 16px;
  border-radius: 0 8px 8px 0;
  margin-bottom: 12px;
}

/* Kategori 2: Customer Service Layout */
.cs-full-container {
  max-width: 960px;
  width: 100%;
  margin: 0 auto;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 14px 18px 18px;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
}
.cs-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ecfdf5;
  border: 1.5px solid #a7f3d0;
  padding: 12px 18px;
  border-radius: 10px;
  margin-bottom: 12px;
  flex-shrink: 0;
  gap: 12px;
  flex-wrap: wrap;
}
.cs-status-info {
  display: flex;
  align-items: center;
  gap: 10px;
}
.cs-status-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.cs-identity-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 20px;
}
.cs-identity-pill.pill-registered {
  background: #dcfce7;
  color: #166534;
  border: 1px solid #86efac;
}
.cs-identity-pill.pill-guest {
  background: #e0f2fe;
  color: #0369a1;
  border: 1px solid #7dd3fc;
}
.btn-ganti-identitas {
  background: #ffffff;
  border: 1px solid #cbd5e1;
  color: #475569;
  padding: 5px 11px;
  border-radius: 6px;
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.2s;
  font-family: inherit;
}
.btn-ganti-identitas:hover {
  background: #fee2e2;
  border-color: #fca5a5;
  color: #b91c1c;
}
.cs-badge-secure {
  font-size: 12px;
  font-weight: 700;
  color: #047857;
  background: #d1fae5;
  padding: 5px 12px;
  border-radius: 20px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.pulse-green-dot {
  width: 10px;
  height: 10px;
  background: #059669;
  border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
}

/* PRE-CHAT SCREEN */
.cs-prechat-screen {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-bottom: 20px;
}
.prechat-hero-banner {
  background: linear-gradient(135deg, #eff6ff 0%, #e0e7ff 100%);
  border: 1px solid #bfdbfe;
  border-radius: 12px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.prechat-banner-icon {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: #003580;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
  box-shadow: 0 4px 10px rgba(0, 53, 128, 0.25);
}
.prechat-banner-title {
  margin: 0 0 4px;
  font-size: 16px;
  font-weight: 800;
  color: #002255;
}
.prechat-banner-desc {
  margin: 0;
  font-size: 13px;
  color: #334155;
  line-height: 1.5;
}

/* Pre-Chat Cards Grid */
.prechat-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.prechat-option-card {
  background: #ffffff;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  padding: 18px;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  position: relative;
}
.prechat-option-card:hover {
  border-color: #94a3b8;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
}
.prechat-option-card.active {
  border-color: #003580;
  background: #f8fafc;
  box-shadow: 0 8px 20px rgba(0, 53, 128, 0.12);
}
.prechat-opt-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.prechat-opt-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.prechat-opt-icon.icon-reg {
  background: #e0f2fe;
  color: #0284c7;
}
.prechat-opt-icon.icon-guest {
  background: #fef3c7;
  color: #d97706;
}
.prechat-opt-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10.5px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 10px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin-bottom: 2px;
}
.prechat-opt-tag.tag-reg {
  background: #dcfce7;
  color: #15803d;
}
.prechat-opt-tag.tag-guest {
  background: #fef3c7;
  color: #92400e;
}
.prechat-opt-title {
  margin: 0;
  font-size: 14.5px;
  font-weight: 700;
  color: #0f172a;
}
.prechat-opt-text {
  margin: 0 0 12px;
  font-size: 12.5px;
  color: #64748b;
  line-height: 1.5;
  flex: 1;
}
.prechat-opt-select-indicator {
  font-size: 11.5px;
  font-weight: 700;
  color: #003580;
  display: none;
  align-items: center;
  gap: 4px;
}
.prechat-option-card.active .prechat-opt-select-indicator {
  display: flex;
}

/* Pre-Chat Form Boxes */
.prechat-form-box {
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
.prechat-form-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
  border-bottom: 1px solid #f1f5f9;
  padding-bottom: 12px;
}
.prechat-form-header strong {
  display: block;
  font-size: 14.5px;
  color: #0f172a;
  margin-bottom: 2px;
}
.prechat-form-header p {
  margin: 0;
  font-size: 12.5px;
  color: #64748b;
  line-height: 1.45;
}
.text-reg-icon {
  font-size: 24px;
  color: #0284c7;
  flex-shrink: 0;
  margin-top: 2px;
}
.text-guest-icon {
  font-size: 24px;
  color: #f59e0b;
  flex-shrink: 0;
  margin-top: 2px;
}
.prechat-label {
  font-size: 13px;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 6px;
}
.prechat-input-action-row {
  display: flex;
  gap: 10px;
  align-items: center;
}
.prechat-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
}
.prechat-input-wrapper .input-icon {
  position: absolute;
  left: 14px;
  color: #64748b;
  font-size: 14px;
  pointer-events: none;
}
.prechat-text-input {
  width: 100%;
  padding: 12px 14px 12px 38px;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  color: #1e293b;
  background: #f8fafc;
  box-sizing: border-box;
  transition: all 0.2s;
}
.prechat-text-input:focus {
  outline: none;
  border-color: #003580;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(0, 53, 128, 0.12);
}
.btn-prechat-action {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 12px 20px;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  font-family: inherit;
  box-shadow: 0 3px 10px rgba(0, 53, 128, 0.2);
  transition: all 0.2s;
  flex-shrink: 0;
}
.btn-prechat-action:hover {
  background: #001938;
  transform: translateY(-1px);
}
.prechat-help-text {
  display: block;
  font-size: 11.5px;
  color: #64748b;
  margin-top: 6px;
}
.prechat-alert-error {
  margin-top: 14px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-left: 4px solid #ef4444;
  border-radius: 0 8px 8px 0;
  padding: 12px 16px;
  color: #991b1b;
  font-size: 13px;
  line-height: 1.5;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.prechat-verified-preview {
  margin-top: 16px;
  background: #f0fdf4;
  border: 1.5px solid #86efac;
  border-radius: 10px;
  padding: 16px;
  animation: fadeInFullscreen 0.25s ease-out;
}
.verified-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #bbf7d0;
  padding-bottom: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
}
.badge-terverifikasi {
  background: #16a34a;
  color: #ffffff;
  font-size: 10.5px;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 20px;
  letter-spacing: 0.3px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.preview-details-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  color: #1e293b;
}
.preview-details-table th {
  width: 140px;
  text-align: left;
  font-weight: 600;
  color: #475569;
  padding: 6px 0;
}
.preview-details-table td {
  padding: 6px 0;
}
.badge-status-aktif {
  background: #dbeafe;
  color: #1e40af;
  font-size: 11.5px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 12px;
  text-transform: uppercase;
}
.btn-confirm-chat {
  background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 12px 22px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: inherit;
  box-shadow: 0 3px 10px rgba(22, 163, 74, 0.25);
  transition: all 0.2s;
}
.btn-confirm-chat:hover {
  background: #14532d;
  transform: translateY(-1px);
}
.btn-guest-confirm {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  box-shadow: 0 3px 10px rgba(0, 53, 128, 0.25);
}
.btn-guest-confirm:hover {
  background: #001938;
}
.prechat-guest-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

/* ACTIVE CHAT WRAPPER */
.cs-active-chat-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

/* Chat Stream */
.cs-chat-stream {
  flex: 1;
  min-height: 0;
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 18px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 12px;
  scroll-behavior: smooth;
}
.chat-msg {
  display: flex;
  gap: 10px;
  max-width: 85%;
}
.chat-msg-bot, .chat-msg-admin {
  align-self: flex-start;
}
.chat-msg-user {
  align-self: flex-end;
  flex-direction: row-reverse;
}
.chat-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #003580;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.chat-bubble {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 14px;
  line-height: 1.55;
  color: #1e293b;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
}
.chat-msg-user .chat-bubble {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  color: #ffffff;
  border-color: #003580;
  border-bottom-right-radius: 2px;
}
.chat-msg-bot .chat-bubble {
  border-left: 4px solid #003580;
  border-bottom-left-radius: 2px;
}
.chat-msg-admin .chat-bubble {
  border-left: 4px solid #16a34a;
  border-bottom-left-radius: 2px;
}
.chat-sender-name {
  font-weight: 700;
  font-size: 12px;
  color: #003580;
  margin-bottom: 4px;
}
.chat-msg-admin .chat-sender-name {
  color: #15803d;
}
.chat-sender-name-user {
  font-size: 12px;
  font-weight: 700;
  color: #fde68a;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.bubble-tag-verified {
  background: #10b981;
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  padding: 1px 7px;
  border-radius: 10px;
}
.chat-text {
  margin: 0;
  font-size: 14px;
  word-break: break-word;
}
.chat-time {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-top: 6px;
  text-align: right;
}
.chat-msg-user .chat-time {
  color: #cbd5e1;
}

/* Verified Client Detail Card in Chat Bubble */
.verified-card-bubble {
  background: #f0fdf4;
  border: 1.5px solid #86efac;
  border-radius: 8px;
  padding: 12px 14px;
  margin: 6px 0;
  color: #1e293b;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
}
.card-bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #bbf7d0;
  padding-bottom: 6px;
  margin-bottom: 8px;
  font-size: 12px;
  color: #166534;
}
.badge-bubble-reg {
  background: #16a34a;
  color: #fff;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 8px;
  font-weight: 700;
}
.card-bubble-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
  color: #1e293b;
  line-height: 1.45;
}
.card-bubble-table th {
  width: 115px;
  text-align: left;
  font-weight: 600;
  color: #475569;
  padding: 2px 0;
}
.card-bubble-table td {
  padding: 2px 0;
}
.text-highlight {
  color: #003580;
  font-weight: 800;
}
.status-pill {
  background: #dbeafe;
  color: #1e40af;
  font-size: 11px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 4px;
}
.card-bubble-note {
  margin-top: 8px;
  font-size: 11.5px;
  color: #15803d;
  display: flex;
  align-items: center;
  gap: 6px;
  font-style: italic;
  border-top: 1px dashed #bbf7d0;
  padding-top: 6px;
}

/* Bottom Chat Input */
.cs-bottom-bar {
  flex-shrink: 0;
  background: #ffffff;
