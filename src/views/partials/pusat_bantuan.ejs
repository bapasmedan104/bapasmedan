<!-- =======================================================
     WIDGET PUSAT BANTUAN TERPADU BAPAS KELAS I MEDAN
     Memiliki 2 Kategori:
     1. Langkah-Langkah Bantuan (Panduan Lengkap & Interaktif)
     2. Customer Service Real-Time (Live Chat & WhatsApp CS)
     ======================================================= -->

<!-- TOMBOL FLOATING PUSAT BANTUAN -->
<div id="btnPusatBantuanFloating" class="btn-pusat-bantuan-floating" onclick="bukaPusatBantuan()" title="Buka Pusat Bantuan & Customer Service">
  <div class="pulse-online-badge"></div>
  <i class="fas fa-headset"></i>
  <span class="btn-bantuan-text">Pusat Bantuan</span>
</div>

<!-- MODAL POPUP PUSAT BANTUAN -->
<div id="modalPusatBantuan" class="modal-bantuan-backdrop" style="display:none;" onclick="handleBackdropClick(event)">
  <div class="modal-bantuan-card">
    
    <!-- Modal Header -->
    <div class="modal-bantuan-header">
      <div style="display:flex; align-items:center; gap:12px;">
        <img src="/logo_pemasyarakatan_custom.png?v=2" alt="Logo" style="height:36px; width:auto;" onerror="this.src='/logo_pemasyarakatan-removebg-preview.png'">
        <div>
          <h3 style="margin:0; font-size:16px; color:#ffffff; font-family:'Playfair Display', serif; display:flex; align-items:center; gap:6px;">
            <i class="fas fa-life-ring" style="color:#f59e0b;"></i> Pusat Bantuan BAPAS Medan
          </h3>
          <span style="font-size:11.5px; color:#fde68a; display:block; margin-top:2px;">Kementerian Imigrasi dan Pemasyarakatan RI</span>
        </div>
      </div>
      <button type="button" class="btn-close-bantuan" onclick="tutupPusatBantuan()" aria-label="Tutup Pusat Bantuan">&times;</button>
    </div>

    <!-- 2 KATEGORI TABS (SESUAI PERMINTAAN USER) -->
    <div class="bantuan-tabs-nav">
      <button type="button" id="tabHeadLangkah" class="bantuan-tab-btn active" onclick="switchKategoriBantuan('langkah')">
        <i class="fas fa-book-reader"></i>
        <span>1. Langkah-Langkah Bantuan</span>
      </button>
      <button type="button" id="tabHeadCS" class="bantuan-tab-btn" onclick="switchKategoriBantuan('cs')">
        <div class="cs-indicator-dot"></div>
        <i class="fas fa-comments"></i>
        <span>2. Customer Service Real-Time</span>
      </button>
    </div>

    <!-- MODAL BODY -->
    <div class="modal-bantuan-body">
      
      <!-- ==============================================
           KATEGORI 1: LANGKAH-LANGKAH BANTUAN (PANDUAN)
           ============================================== -->
      <div id="kategoriLangkah" class="kategori-pane active">
        <div style="margin-bottom:14px; background:#f0fdf4; border:1px solid #bbf7d0; padding:10px 14px; border-radius:8px; font-size:12.5px; color:#166534; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-info-circle" style="color:#16a34a; font-size:16px; flex-shrink:0;"></i>
          <span>Pilih topik di bawah ini untuk panduan langkah demi langkah penggunaan layanan wajib lapor online.</span>
        </div>

        <!-- ACCORDION PANDUAN LANGKAH-LANGKAH -->
        <div class="faq-accordion-group">
          
          <!-- Panduan 1: Login -->
          <details class="bantuan-item" open>
            <summary>
              <span><i class="fas fa-sign-in-alt text-primary"></i> Langkah 1: Cara Masuk / Login ke Akun Klien</span>
              <i class="fas fa-chevron-down arrow-icon"></i>
            </summary>
            <div class="bantuan-content">
              <p>Untuk masuk ke portal wajib lapor online BAPAS Kelas I Medan:</p>
              <ol>
                <li>Buka halaman masuk melalui menu <strong>Wajib Lapor Online</strong> atau kunjungi <a href="/login" style="color:#003580; font-weight:700;">bapas1medan.com/login</a>.</li>
                <li>Masukkan <strong>Nomor WhatsApp</strong> aktif atau <strong>Nomor Register Klien</strong> (contoh: <code>REG-2026</code>).</li>
                <li>Masukkan Kata Sandi akun yang telah diberikan oleh Pembimbing Kemasyarakatan (PK).</li>
                <li>Selesaikan verifikasi keamanan Cloudflare Turnstile, lalu klik <strong>Masuk ke Portal Klien</strong>.</li>
              </ol>
              <small style="color:#64748b;">*Jika Anda lupa kata sandi, hubungi petugas PK Anda atau kirim pesan di Kategori 2 Customer Service.</small>
            </div>
          </details>

          <!-- Panduan 2: Periode Jadwal -->
          <details class="bantuan-item">
            <summary>
              <span><i class="fas fa-calendar-alt text-primary"></i> Langkah 2: Jadwal & Waktu Wajib Lapor Dibuka</span>
              <i class="fas fa-chevron-down arrow-icon"></i>
            </summary>
            <div class="bantuan-content">
              <div style="background:#eff6ff; border-left:4px solid #003580; padding:10px 12px; border-radius:0 6px 6px 0; margin-bottom:10px;">
                <strong style="color:#002255; font-size:13px; display:block;">Jadwal Resmi Berdasarkan Sistem:</strong>
                <span style="color:#334155; font-size:13px;">
                  <% if (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.teks_pengumuman) { %>
                    <%= konfigurasi.teks_pengumuman %>
                  <% } else { %>
                    Layanan dibuka setiap tanggal <strong><%= (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.tanggal_mulai_input) ? konfigurasi.tanggal_mulai_input : 1 %> s/d <%= (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.tanggal_akhir_input) ? konfigurasi.tanggal_akhir_input : 15 %> setiap bulannya</strong>.
                  <% } %>
                </span>
              </div>
              <p>Klien diwajibkan melapor tepat waktu di dalam rentang tanggal tersebut. Di luar tanggal ini, sistem pelaporan online ditutup secara otomatis untuk evaluasi bulanan.</p>
            </div>
          </details>

          <!-- Panduan 3: Profil -->
          <details class="bantuan-item">
            <summary>
              <span><i class="fas fa-user-edit text-primary"></i> Langkah 3: Melengkapi Profil & Masa Wajib Lapor</span>
              <i class="fas fa-chevron-down arrow-icon"></i>
            </summary>
            <div class="bantuan-content">
              <ol>
                <li>Sebelum membuat laporan pertama, Anda wajib memeriksa dan memperbarui kelengkapan profil.</li>
                <li>Buka menu <strong>Profil Klien</strong> pada dashboard Anda.</li>
                <li>Lengkapi Nama Lengkap sesuai KTP, Nomor WhatsApp Aktif, dan Alamat Domisili tinggal saat ini.</li>
                <li>Kolom <strong>Masa / Periode Wajib Lapor</strong> otomatis terisi dari data penetapan SK admin sehingga Anda tidak perlu repot mengisi manual.</li>
                <li>Klik tombol <strong>Simpan & Perbarui Profil</strong>.</li>
              </ol>
            </div>
          </details>

          <!-- Panduan 4: Kamera & Bukti Presensi -->
          <details class="bantuan-item">
            <summary>
              <span><i class="fas fa-camera text-primary"></i> Langkah 4: Pengambilan Foto Bukti (Kamera Depan / Belakang & Galeri)</span>
              <i class="fas fa-chevron-down arrow-icon"></i>
            </summary>
            <div class="bantuan-content">
              <p>Pada formulir wajib lapor bulanan, Anda dapat memilih dua metode bukti foto:</p>
              <ul>
                <li><strong>Ambil Foto dengan Kamera:</strong> Klik "Buka Kamera". Sistem kini mendukung pergantian <em>Kamera Depan (Selfie)</em> maupun <em>Kamera Belakang</em> ponsel Anda. Klik "Ambil Gambar" saat posisi wajah sudah pas.</li>
                <li><strong>Pilih dari Galeri:</strong> Klik tab "Pilih dari Galeri" untuk mengunggah foto swafoto terkini yang sudah tersimpan di memori ponsel Anda.</li>
                <li>Pastikan foto terang, tidak menggunakan masker/kacamata hitam tebal, dan wajah menghadap lurus ke kamera.</li>
              </ul>
            </div>
          </details>

          <!-- Panduan 5: GPS & Izin Lokasi -->
          <details class="bantuan-item">
            <summary>
              <span><i class="fas fa-map-marker-alt text-primary"></i> Langkah 5: Mengatasi Kendala Lokasi GPS</span>
              <i class="fas fa-chevron-down arrow-icon"></i>
            </summary>
            <div class="bantuan-content">
              <p>Sistem mewajibkan pencatatan geolokasi presensi akurat:</p>
              <ul>
                <li>Saat browser meminta izin lokasi (<em>Location Permission</em>), pilih <strong>Izinkan / Allow</strong>.</li>
                <li>Pastikan GPS pada ponsel Android/iPhone dalam status aktif (Mode Akurasi Tinggi).</li>
                <li><strong>Peringatan Tegas:</strong> Dilarang keras menggunakan aplikasi Fake GPS / Mock Location. Sistem akan otomatis mendeteksi dan menolak laporan dengan lokasi palsu.</li>
              </ul>
            </div>
          </details>

          <!-- Panduan 6: Laporan Ditolak -->
          <details class="bantuan-item">
            <summary>
              <span><i class="fas fa-exclamation-circle text-primary"></i> Langkah 6: Jika Laporan Ditolak Petugas PK</span>
              <i class="fas fa-chevron-down arrow-icon"></i>
            </summary>
            <div class="bantuan-content">
              <p>Apabila laporan Anda berstatus <strong>Ditolak</strong>:</p>
              <ul>
                <li>Buka menu <strong>Riwayat Lapor</strong> di dashboard klien.</li>
                <li>Pada baris laporan yang ditolak, lihat <strong>Alasan Penolakan</strong> dari petugas (misalnya: foto buram atau deskripsi kegiatan belum lengkap).</li>
                <li>Segera perbaiki kekurangan tersebut dan kirim ulang laporan perbaikan sebelum periode pelaporan bulan ini berakhir.</li>
              </ul>
            </div>
          </details>

        </div>
      </div>

      <!-- ==============================================
           KATEGORI 2: CUSTOMER SERVICE REAL-TIME (LIVE CHAT)
           ============================================== -->
      <div id="kategoriCS" class="kategori-pane">
        
        <!-- Bar Status CS Online & WhatsApp Direct -->
        <div class="cs-top-bar">
          <div style="display:flex; align-items:center; gap:8px;">
            <div class="pulse-green-dot"></div>
            <div>
              <strong style="font-size:13px; color:#065f46; display:block;">Petugas Layanan Online</strong>
              <span style="font-size:11.5px; color:#047857;">Balai Pemasyarakatan Kelas I Medan</span>
            </div>
          </div>
          <a href="https://wa.me/6281275623551?text=Halo%20Admin%20Customer%20Service%20BAPAS%20Kelas%20I%20Medan,%20saya%20memerlukan%20bantuan%20terkait%20layanan%20wajib%20lapor..." target="_blank" class="btn-wa-direct-help" title="Chat via WhatsApp">
            <i class="fab fa-whatsapp"></i> Chat WhatsApp
          </a>
        </div>

        <!-- Chat Stream Area -->
        <div id="chatStreamBox" class="chat-stream-box">
          <div class="chat-msg chat-msg-bot">
            <div class="chat-avatar"><i class="fas fa-user-shield"></i></div>
            <div class="chat-bubble">
              <strong>Asisten Layanan BAPAS:</strong>
              <p>Halo! Selamat datang di Customer Service Resmi BAPAS Kelas I Medan. Silakan tuliskan pertanyaan, kendala login, atau pertanyaan wajib lapor Anda di bawah ini. Petugas kami akan merespons percakapan Anda secara real-time.</p>
              <span class="chat-time">Respon Otomatis</span>
            </div>
          </div>
        </div>

        <!-- Chat Input Form -->
        <form id="formKirimBantuanCS" class="chat-input-form" onsubmit="handleKirimPesanCS(event)">
          <% if (!isLoggedIn) { %>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:8px;">
              <input type="text" id="csInputNama" placeholder="Nama Anda *" required style="padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:12.5px;">
              <input type="text" id="csInputKontak" placeholder="No WhatsApp / Register *" required style="padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:12.5px;">
            </div>
          <% } else { %>
            <input type="hidden" id="csInputNama" value="<%= user ? (user.nama_lengkap || user.username) : 'Pengguna' %>">
            <input type="hidden" id="csInputKontak" value="<%= user ? (user.no_telepon || user.no_register || user.email || '-') : '-' %>">
          <% } %>

          <div style="display:flex; gap:8px;">
            <input type="text" id="csInputPesan" placeholder="Ketik pesan atau kendala Anda di sini..." required style="flex:1; padding:10px 14px; border:1.5px solid #cbd5e1; border-radius:8px; font-size:13.5px;" autocomplete="off">
            <button type="submit" id="btnKirimCS" class="btn-kirim-chat" aria-label="Kirim Pesan">
              <i class="fas fa-paper-plane"></i>
            </button>
          </div>
          <small style="color:#64748b; font-size:11px; display:block; margin-top:6px;">
            <i class="fas fa-lock" style="color:#0284c7;"></i> Percakapan dilindungi sistem keamanan data resmi BAPAS Kelas I Medan.
          </small>
        </form>

      </div>

    </div>

  </div>
</div>

<!-- STYLING PUSAT BANTUAN -->
<style>
/* Floating Button */
.btn-pusat-bantuan-floating {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 99990;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #001e4d 0%, #003580 100%);
  color: #ffffff;
  border: 2px solid #f59e0b;
  border-radius: 50px;
  padding: 11px 18px;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(0, 30, 80, 0.4);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  font-family: inherit;
}
.btn-pusat-bantuan-floating:hover {
  transform: translateY(-3px) scale(1.02);
  background: linear-gradient(135deg, #002b66 0%, #0045a5 100%);
  box-shadow: 0 12px 28px rgba(0, 30, 80, 0.55);
}
.btn-pusat-bantuan-floating i {
  font-size: 18px;
  color: #f59e0b;
}
.btn-bantuan-text {
  font-size: 13.5px;
  font-weight: 700;
  letter-spacing: 0.3px;
  color: #ffffff;
}
.pulse-online-badge {
  width: 9px;
  height: 9px;
  background: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  animation: pulseGreen 1.8s infinite;
}
@keyframes pulseGreen {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

/* Modal Backdrop */
.modal-bantuan-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 15, 40, 0.75);
  backdrop-filter: blur(4px);
  z-index: 99995;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 15px;
  box-sizing: border-box;
  animation: fadeInHelp 0.2s ease;
}
@keyframes fadeInHelp {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Modal Card */
.modal-bantuan-card {
  background: #ffffff;
  border-radius: 14px;
  max-width: 660px;
  width: 100%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
  animation: slideUpCard 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes slideUpCard {
  from { transform: translateY(20px) scale(0.97); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

/* Header */
.modal-bantuan-header {
  background: linear-gradient(135deg, #001938 0%, #002b66 100%);
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #f59e0b;
}
.btn-close-bantuan {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: #ffffff;
  font-size: 26px;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  line-height: 1;
}
.btn-close-bantuan:hover {
  background: #dc2626;
  color: #ffffff;
}

/* Navigation Tabs (2 Kategori) */
.bantuan-tabs-nav {
  display: flex;
  background: #f1f5f9;
  border-bottom: 1.5px solid #cbd5e1;
}
.bantuan-tab-btn {
  flex: 1;
  padding: 13px 16px;
  border: none;
  background: transparent;
  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  color: #475569;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s;
  position: relative;
}
.bantuan-tab-btn.active {
  background: #ffffff;
  color: #003580;
  border-bottom: 3px solid #003580;
}
.cs-indicator-dot {
  width: 8px;
  height: 8px;
  background: #10b981;
  border-radius: 50%;
}

/* Modal Body */
.modal-bantuan-body {
  padding: 18px 20px;
  overflow-y: auto;
  flex: 1;
  max-height: 65vh;
}
.kategori-pane {
  display: none;
}
.kategori-pane.active {
  display: block;
}

/* Accordion Styling */
.faq-accordion-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.bantuan-item {
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
  overflow: hidden;
  transition: all 0.2s;
}
.bantuan-item summary {
  padding: 12px 16px;
  font-weight: 700;
  font-size: 13.5px;
  color: #1e293b;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.bantuan-item summary::-webkit-details-marker {
  display: none;
}
.bantuan-item[open] summary {
  background: #e0f2fe;
  color: #003580;
  border-bottom: 1px solid #bae6fd;
}
.bantuan-item summary .arrow-icon {
  font-size: 12px;
  color: #64748b;
  transition: transform 0.2s;
}
.bantuan-item[open] summary .arrow-icon {
  transform: rotate(180deg);
}
.bantuan-content {
  padding: 14px 18px;
  font-size: 13px;
  line-height: 1.7;
  color: #334155;
  background: #ffffff;
}
.bantuan-content ol, .bantuan-content ul {
  padding-left: 20px;
  margin: 8px 0;
}
.text-primary {
  color: #003580;
  margin-right: 6px;
}

/* Category 2 (CS Real-Time) */
.cs-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 14px;
}
.pulse-green-dot {
  width: 9px;
  height: 9px;
  background: #059669;
  border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
}
.btn-wa-direct-help {
  background: #25d366;
  color: #ffffff;
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 20px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s;
}
.btn-wa-direct-help:hover {
  background: #1eb857;
  color: #ffffff;
}

/* Chat Stream Box */
.chat-stream-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 14px;
  min-height: 220px;
  max-height: 300px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 14px;
}
.chat-msg {
  display: flex;
  gap: 10px;
  max-width: 85%;
}
.chat-msg-bot, .chat-msg-admin {
  align-self: flex-start;
}
.chat-msg-user {
  align-self: flex-end;
  flex-direction: row-reverse;
}
.chat-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #003580;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  flex-shrink: 0;
}
.chat-bubble {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 13px;
  line-height: 1.5;
  color: #1e293b;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}
.chat-msg-user .chat-bubble {
  background: #003580;
  color: #ffffff;
  border-color: #003580;
}
.chat-time {
  display: block;
  font-size: 10.5px;
  color: #94a3b8;
  margin-top: 4px;
  text-align: right;
}
.chat-msg-user .chat-time {
  color: #cbd5e1;
}

/* Chat Input */
.btn-kirim-chat {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 0 18px;
  font-size: 15px;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-kirim-chat:hover {
  background: #f59e0b;
  color: #001e4d;
}

@media (max-width: 600px) {
  .btn-pusat-bantuan-floating {
    bottom: 16px;
    right: 16px;
    padding: 9px 14px;
  }
  .btn-bantuan-text {
    font-size: 12px;
  }
  .bantuan-tab-btn {
    font-size: 11.5px;
    padding: 11px 8px;
  }
}
</style>

<!-- SCRIPT PUSAT BANTUAN -->
<script>
let bapasChatPollTimer = null;

function getBapasSessionId() {
  let sId = localStorage.getItem('bapas_cs_session');
  if (!sId) {
    sId = 'cs_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7);
    localStorage.setItem('bapas_cs_session', sId);
  }
  return sId;
}

function bukaPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // Jika tab CS aktif, muat riwayat pesan
    if (document.getElementById('kategoriCS').classList.contains('active')) {
      startChatPolling();
    }
  }
}

function tutupPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
  stopChatPolling();
}

function handleBackdropClick(e) {
  if (e.target.id === 'modalPusatBantuan') {
    tutupPusatBantuan();
  }
}

function switchKategoriBantuan(kat) {
  const btnLangkah = document.getElementById('tabHeadLangkah');
  const btnCS = document.getElementById('tabHeadCS');
  const paneLangkah = document.getElementById('kategoriLangkah');
  const paneCS = document.getElementById('kategoriCS');

  if (kat === 'langkah') {
    btnLangkah.classList.add('active');
    btnCS.classList.remove('active');
    paneLangkah.classList.add('active');
    paneCS.classList.remove('active');
    stopChatPolling();
  } else {
    btnCS.classList.add('active');
    btnLangkah.classList.remove('active');
    paneCS.classList.add('active');
    paneLangkah.classList.remove('active');
    startChatPolling();
  }
}

async function loadChatMessages() {
  const sId = getBapasSessionId();
  try {
    const res = await fetch('/api/pusat-bantuan/pesan/' + sId);
    const data = await res.json();
    if (data.success && Array.isArray(data.data)) {
      renderChatStream(data.data);
    }
  } catch (err) {
    console.warn('Gagal memuat chat bantuan:', err);
  }
}

function renderChatStream(messages) {
  const box = document.getElementById('chatStreamBox');
  if (!box) return;

  let html = `
    <div class="chat-msg chat-msg-bot">
      <div class="chat-avatar"><i class="fas fa-user-shield"></i></div>
      <div class="chat-bubble">
        <strong>Asisten Layanan BAPAS:</strong>
        <p>Halo! Selamat datang di Customer Service Resmi BAPAS Kelas I Medan. Silakan tuliskan pertanyaan atau kendala wajib lapor Anda di bawah ini.</p>
        <span class="chat-time">Respon Otomatis</span>
      </div>
    </div>
  `;

  messages.forEach(m => {
    const isUser = m.pengirim === 'user';
    const isBot = m.pengirim === 'bot';
    const timeFormatted = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' }) : '';

    if (isUser) {
      html += `
        <div class="chat-msg chat-msg-user">
          <div class="chat-bubble">
            <p style="margin:0;">${escapeHtml(m.pesan)}</p>
            <span class="chat-time">${timeFormatted} &bull; Anda</span>
          </div>
        </div>
      `;
    } else {
      const senderTitle = isBot ? 'Asisten Virtual BAPAS' : (m.admin_name || 'Petugas CS BAPAS');
      html += `
        <div class="chat-msg chat-msg-admin">
          <div class="chat-avatar" style="${isBot ? '' : 'background:#16a34a;'}"><i class="fas ${isBot ? 'fa-robot' : 'fa-headset'}"></i></div>
          <div class="chat-bubble">
            <strong style="color:${isBot ? '#003580' : '#15803d'}; font-size:12px;">${escapeHtml(senderTitle)}:</strong>
            <p style="margin:4px 0 0;">${escapeHtml(m.pesan)}</p>
            <span class="chat-time">${timeFormatted}</span>
          </div>
        </div>
      `;
    }
  });

  box.innerHTML = html;
  box.scrollTop = box.scrollHeight;
}

function startChatPolling() {
  loadChatMessages();
  if (!bapasChatPollTimer) {
    bapasChatPollTimer = setInterval(loadChatMessages, 3500);
  }
}

function stopChatPolling() {
  if (bapasChatPollTimer) {
    clearInterval(bapasChatPollTimer);
    bapasChatPollTimer = null;
  }
}

async function handleKirimPesanCS(e) {
  e.preventDefault();
  const inputPesan = document.getElementById('csInputPesan');
  const inputNama = document.getElementById('csInputNama');
  const inputKontak = document.getElementById('csInputKontak');
  const btnKirim = document.getElementById('btnKirimCS');

  const pesan = (inputPesan.value || '').trim();
  const nama = (inputNama.value || '').trim();
  const kontak = (inputKontak.value || '').trim();
  const sId = getBapasSessionId();

  if (!pesan) return;

  btnKirim.disabled = true;
  btnKirim.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  try {
    const res = await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama || 'Pengunjung',
        kontak: kontak || '-',
        pesan: pesan
      })
    });
    const result = await res.json();
    if (result.success) {
      inputPesan.value = '';
      loadChatMessages();
    } else {
      alert(result.message || 'Gagal mengirim pesan');
    }
  } catch (err) {
    alert('Terjadi kesalahan jaringan: ' + err.message);
  } finally {
    btnKirim.disabled = false;
    btnKirim.innerHTML = '<i class="fas fa-paper-plane"></i>';
  }
}

function escapeHtml(text) {
  if (!text) return '';
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
</script>
