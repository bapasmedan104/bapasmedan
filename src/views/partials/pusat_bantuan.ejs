<!-- ==============================================
     LOGIKA REAL-TIME SCRIPT PUSAT BANTUAN
     ============================================== -->
<script>
let bapasChatPollTimer = null;
let lastRenderedChatJson = '';
let verifiedClientData = null;

function getBapasSessionId() {
  let sId = localStorage.getItem('bapas_cs_session');
  if (!sId) {
    sId = 'cs_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8);
    localStorage.setItem('bapas_cs_session', sId);
  }
  return sId;
}

function initCsViewState() {
  // Jika sedang login sebagai klien binaan di portal, otomatis gunakan identitas klien (kecuali jika sedang ganti identitas)
  <% if (isLoggedIn && user && (user.no_register || userType === 'client')) { %>
    const loggedInReg = '<%= user.no_register || "" %>';
    const loggedInName = '<%= user.nama_lengkap || user.username || "Klien BAPAS" %>';
    const loggedInPhone = '<%= user.no_telepon || "-" %>';
    const isForcedSelect = localStorage.getItem('bapas_cs_force_select');
    if (!isForcedSelect && !localStorage.getItem('bapas_cs_nama') && loggedInReg) {
      localStorage.setItem('bapas_cs_type', 'registered');
      localStorage.setItem('bapas_cs_nama', loggedInName);
      localStorage.setItem('bapas_cs_register', loggedInReg);
      localStorage.setItem('bapas_cs_kontak', loggedInPhone);
    }
  <% } %>

  const csNama = localStorage.getItem('bapas_cs_nama');
  const csType = localStorage.getItem('bapas_cs_type');
  const csRegister = localStorage.getItem('bapas_cs_register');

  const prechatContainer = document.getElementById('csPrechatContainer');
  const activeChatContainer = document.getElementById('csChatActiveContainer');
  const identityPill = document.getElementById('csIdentityPill');
  const btnGanti = document.getElementById('btnGantiIdentitasCS');
  const btnKeluar = document.getElementById('btnKeluarCS');
  const btnAkhiri = document.getElementById('btnAkhiriCS');
  const quickKatalogBar = document.getElementById('csQuickKatalogBar');
  const statusBar = document.getElementById('csStatusBar') || document.querySelector('.cs-status-bar');

  if (csNama && (csType === 'guest' || (csType === 'registered' && csRegister))) {
    // Sesi sudah memiliki identitas, buka percakapan aktif
    if (statusBar) statusBar.classList.add('in-chat-mode');
    if (prechatContainer) prechatContainer.style.display = 'none';
    if (activeChatContainer) activeChatContainer.style.display = 'flex';
    if (identityPill) {
      identityPill.style.display = 'inline-flex';
      if (csType === 'registered') {
        identityPill.innerHTML = `<i class="fas fa-check-circle" style="color:#10b981;"></i> <span>${escapeHtml(csRegister)} (${escapeHtml(csNama)})</span>`;
        identityPill.className = 'cs-identity-pill pill-registered';
      } else {
        identityPill.innerHTML = `<i class="fas fa-user"></i> <span>${escapeHtml(csNama)}</span>`;
        identityPill.className = 'cs-identity-pill pill-guest';
      }
    }
    if (btnGanti) btnGanti.style.display = 'inline-flex';
    if (btnKeluar) btnKeluar.style.display = 'inline-flex';
    if (btnAkhiri) btnAkhiri.style.display = 'inline-flex';
    if (quickKatalogBar) {
      quickKatalogBar.style.display = (csType === 'registered') ? 'flex' : 'none';
    }
  } else {
    // Tampilkan layar pre-chat selection
    if (statusBar) statusBar.classList.remove('in-chat-mode');
    if (prechatContainer) prechatContainer.style.display = 'flex';
    if (activeChatContainer) activeChatContainer.style.display = 'none';
    if (identityPill) identityPill.style.display = 'none';
    if (btnGanti) btnGanti.style.display = 'none';
    if (btnKeluar) btnKeluar.style.display = 'none';
    if (btnAkhiri) btnAkhiri.style.display = 'none';
    if (quickKatalogBar) quickKatalogBar.style.display = 'none';
  }
}

function gantiIdentitasCS() {
  if (!confirm('Apakah Anda ingin mengganti identitas obrolan Customer Service? Anda dapat memilih masuk sebagai Klien Binaan lain atau Pengunjung Umum.')) {
    return;
  }
  // Tandai flag force_select agar sesi login tidak langsung mengisi identitas lama
  localStorage.setItem('bapas_cs_force_select', 'true');
  localStorage.removeItem('bapas_cs_type');
  localStorage.removeItem('bapas_cs_nama');
  localStorage.removeItem('bapas_cs_register');
  localStorage.removeItem('bapas_cs_kontak');
  localStorage.removeItem('bapas_cs_detail');
  localStorage.removeItem('bapas_cs_session');
  stopChatPolling();
  lastRenderedChatJson = '';
  verifiedClientData = null;

  // Bersihkan input formulir
  const inputReg = document.getElementById('inputCsNoRegister');
  if (inputReg) inputReg.value = '';
  const inputGuest = document.getElementById('inputCsNamaGuest');
  if (inputGuest) inputGuest.value = '';
  const inputGuestPhone = document.getElementById('inputCsKontakGuest');
  if (inputGuestPhone) inputGuestPhone.value = '';

  const alertRegErr = document.getElementById('alertRegisterError');
  if (alertRegErr) { alertRegErr.style.display = 'none'; alertRegErr.innerHTML = ''; }
  const previewBox = document.getElementById('previewRegisterSuccess');
  if (previewBox) { previewBox.style.display = 'none'; }
  const alertGuestErr = document.getElementById('alertGuestError');
  if (alertGuestErr) { alertGuestErr.style.display = 'none'; alertGuestErr.innerHTML = ''; }

  initCsViewState();
  selectCsOption('registered');
}

function keluarPercakapanCS() {
  // Tutup antarmuka Pusat Bantuan tanpa menghapus obrolan
  tutupPusatBantuan();
}

async function akhiriPercakapanCS() {
  if (!confirm('Apakah Anda yakin ingin mengakhiri sesi percakapan Customer Service ini?\n\nSeluruh riwayat pesan obrolan ini akan otomatis dihapus secara permanen dari server database demi privasi & keamanan Anda.')) {
    return;
  }
  const sId = getBapasSessionId();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Pengguna';
  
  try {
    await fetch('/api/pusat-bantuan/akhiri', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama
      })
    });
  } catch (err) {
    console.warn('Gagal memproses akhir sesi:', err);
  }
  mulaiObrolanBaruCS();
  alert('Percakapan telah diakhiri dan seluruh riwayat pesan telah DIHAPUS PERMANEN.');
}

function mulaiObrolanBaruCS() {
  cancelReplyCS();
  stopChatPolling();
  localStorage.setItem('bapas_cs_force_select', 'true');
  localStorage.removeItem('bapas_cs_session');
  localStorage.removeItem('bapas_cs_nama');
  localStorage.removeItem('bapas_cs_register');
  localStorage.removeItem('bapas_cs_kontak');
  localStorage.removeItem('bapas_cs_detail');
  localStorage.removeItem('bapas_cs_type');
  lastRenderedChatJson = '';
  verifiedClientData = null;
  initCsViewState();
  selectCsOption('registered');
}

function resetCsSession() {
  gantiIdentitasCS();
}

function selectCsOption(type) {
  const cardReg = document.getElementById('cardOptRegister');
  const cardGuest = document.getElementById('cardOptGuest');
  const panelReg = document.getElementById('panelFormRegister');
  const panelGuest = document.getElementById('panelFormGuest');

  if (type === 'registered') {
    if (cardReg) cardReg.classList.add('active');
    if (cardGuest) cardGuest.classList.remove('active');
    if (panelReg) panelReg.style.display = 'block';
    if (panelGuest) panelGuest.style.display = 'none';
    const inputReg = document.getElementById('inputCsNoRegister');
    if (inputReg) setTimeout(() => inputReg.focus(), 100);
  } else {
    if (cardGuest) cardGuest.classList.add('active');
    if (cardReg) cardReg.classList.remove('active');
    if (panelGuest) panelGuest.style.display = 'block';
    if (panelReg) panelReg.style.display = 'none';
    const inputGuest = document.getElementById('inputCsNamaGuest');
    if (inputGuest) setTimeout(() => inputGuest.focus(), 100);
  }
}

async function verifikasiNoRegister() {
  const input = document.getElementById('inputCsNoRegister');
  const val = (input ? input.value : '').trim();
  const alertErr = document.getElementById('alertRegisterError');
  const previewBox = document.getElementById('previewRegisterSuccess');
  const previewDetails = document.getElementById('previewRegisterDetails');
  const btn = document.getElementById('btnCekRegister');

  if (alertErr) {
    alertErr.style.display = 'none';
    alertErr.innerHTML = '';
  }
  if (previewBox) previewBox.style.display = 'none';

  if (!val) {
    if (alertErr) {
      alertErr.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Harap masukkan nomor registrasi klien Anda (contoh: REG-2026).';
      alertErr.style.display = 'flex';
    }
    if (input) input.focus();
    return;
  }

  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Memeriksa...</span>';
  }

  try {
    const res = await fetch('/api/pusat-bantuan/cek-registrasi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ no_register: val })
    });
    const data = await res.json();
    if (!data.success) {
      if (alertErr) {
        alertErr.innerHTML = `<i class="fas fa-times-circle"></i> <span>${escapeHtml(data.message || 'Gagal memeriksa nomor register.')}</span>`;
        alertErr.style.display = 'flex';
      }
    } else if (!data.found) {
      if (alertErr) {
        alertErr.innerHTML = `
          <i class="fas fa-times-circle" style="font-size:18px; margin-top:2px;"></i>
          <div>
            <strong>Nomor Register Tidak Ditemukan</strong><br>
            ${escapeHtml(data.message)}<br>
            <small style="display:inline-block; margin-top:5px; color:#b91c1c;">
              Jika Anda adalah pengunjung atau masyarakat umum, silakan pilih kartu <strong>Belum Punya Nomor Registrasi</strong> di atas.
            </small>
          </div>
        `;
        alertErr.style.display = 'flex';
      }
    } else {
      // Data klien ditemukan
      verifiedClientData = data.client;
      if (previewDetails) {
        previewDetails.innerHTML = `
          <table class="preview-details-table">
            <tr><th>No. Registrasi:</th><td style="color:#003580; font-weight:800; font-size:14px;">${escapeHtml(data.client.no_register)}</td></tr>
            <tr><th>Nama Lengkap:</th><td style="font-weight:700;">${escapeHtml(data.client.nama_lengkap)}</td></tr>
            <tr><th>Status Binaan:</th><td><span class="badge-status-aktif">${escapeHtml(data.client.status)}</span></td></tr>
            <tr><th>Masa Wajib Lapor:</th><td style="color:#b45309; font-weight:700;">${escapeHtml(data.client.masa_wajib_lapor)}</td></tr>
            <tr><th>Kontak / Telp:</th><td>${escapeHtml(data.client.no_telepon)}</td></tr>
            <tr><th>Alamat Domisili:</th><td>${escapeHtml(data.client.alamat)}</td></tr>
          </table>
          <div style="margin-top:10px; font-size:12px; color:#15803d; font-style:italic;">
            <i class="fas fa-shield-alt"></i> Data ini akan otomatis disampaikan ke ruang percakapan Customer Service BAPAS Medan.
          </div>
        `;
      }
      if (previewBox) previewBox.style.display = 'block';
    }
  } catch (err) {
    if (alertErr) {
      alertErr.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Terjadi kesalahan jaringan saat memverifikasi: ${escapeHtml(err.message)}`;
      alertErr.style.display = 'flex';
    }
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-search"></i> <span>Periksa Data</span>';
    }
  }
}

async function mulaiChatTerverifikasi() {
  if (!verifiedClientData) {
    alert('Silakan lakukan pemeriksaan nomor registrasi terlebih dahulu.');
    return;
  }

  const sId = getBapasSessionId();
  const client = verifiedClientData;

  localStorage.removeItem('bapas_cs_force_select');
  localStorage.setItem('bapas_cs_type', 'registered');
  localStorage.setItem('bapas_cs_nama', client.nama_lengkap);
  localStorage.setItem('bapas_cs_register', client.no_register);
  localStorage.setItem('bapas_cs_kontak', client.no_telepon || client.no_register);
  localStorage.setItem('bapas_cs_detail', JSON.stringify(client));

  // Tampilkan layar chat aktif
  initCsViewState();

  // Kirimkan kartu verifikasi data registrasi klien ke log percakapan
  try {
    await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: client.nama_lengkap,
        kontak: client.no_telepon || client.no_register,
        pesan: `[KLIEN TERVERIFIKASI RESMI] Halo Customer Service BAPAS Medan, data bimbingan saya dengan No. Register ${client.no_register} telah terverifikasi resmi oleh sistem.`,
        is_verified: true,
        tipe_pesan: 'client_card',
        detail_klien: client
      })
    });
  } catch (e) {
    console.warn('Gagal memposting data verifikasi awal:', e);
  }

  // Kirimkan pesan sambutan sekaligus Katalog Bantuan Cepat interaktif
  try {
    await fetch('/api/pusat-bantuan/bot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        pesan: `Halo ${client.nama_lengkap}! Identitas registrasi Anda (${client.no_register}) telah terverifikasi resmi oleh sistem BAPAS Medan. Silakan pilih topik kendala atau pertanyaan yang Anda butuhkan melalui Katalog Bantuan Cepat di bawah ini:`,
        topik: 'welcome',
        detail_klien: client
      })
    });
  } catch (e) {
    console.warn('Gagal memposting katalog bot awal:', e);
  }

  startChatPolling();
}

