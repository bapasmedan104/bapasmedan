        if (!clientData) {
          clientData = {
            no_register: currentCsRegister || m.kontak || '-',
            nama_lengkap: m.nama,
            status: 'aktif',
            masa_wajib_lapor: 'Terdaftar di BAPAS Medan',
            no_telepon: m.kontak || '-',
            alamat: '-'
          };
        }
        contentHtml = renderVerifiedClientCardHtml(clientData, m.pesan);
      } else {
        const isKatalogInquiry = m.tipe_pesan === 'katalog_inquiry';
        contentHtml = `<p class="chat-text">${isKatalogInquiry ? '<span class="badge-katalog-inquiry"><i class="fas fa-bolt"></i> Bantuan Cepat</span>' : ''}${escapeHtml(m.pesan)}</p>`;
      }

      const displayName = m.nama || localStorage.getItem('bapas_cs_nama') || 'Anda';
      const isReg = m.is_verified || Boolean(m.detail_klien) || Boolean(currentCsRegister);
      const rawSnippet = (m.pesan || (m.tipe_pesan === 'client_card' ? 'Data Klien Terverifikasi' : '')).replace(/\s+/g, ' ').trim().substring(0, 150);

      html += `
        <div class="chat-msg chat-msg-user" id="cs-msg-${escapeHtml(m.id || '')}">
          <div class="chat-bubble">
            <div class="chat-sender-name-user">
              <i class="fas ${isReg ? 'fa-id-badge' : 'fa-user-circle'}"></i> 
              <span>${escapeHtml(displayName)}</span>
              ${isReg ? '<span class="bubble-tag-verified"><i class="fas fa-check-circle"></i> Terverifikasi</span>' : ''}
            </div>
            ${quoteHtml}
            ${contentHtml}
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px;">
              <button type="button" class="btn-cs-reply" onclick="handleReplyCsClick(this)" data-id="${escapeHtml(m.id || '')}" data-sender="${escapeHtml(displayName)}" data-text="${escapeHtml(rawSnippet)}">
                <i class="fas fa-reply"></i> Balas
              </button>
              <span class="chat-time" style="margin-top:0;">${timeFormatted} &bull; Terkirim</span>
            </div>
          </div>
        </div>
      `;
    } else {
      const senderTitle = isBot ? 'Asisten Layanan BAPAS' : (m.admin_name || m.nama || 'Petugas CS BAPAS');
      const isAutoAnswer = m.tipe_pesan && m.tipe_pesan.startsWith('katalog_jawaban');
      const formattedBotText = escapeHtml(m.pesan).replace(/\n/g, '<br>');
      const rawSnippet = (m.pesan || '').replace(/\s+/g, ' ').trim().substring(0, 150);

      html += `
        <div class="chat-msg ${isBot ? 'chat-msg-bot' : 'chat-msg-admin'}" id="cs-msg-${escapeHtml(m.id || '')}">
          <div class="chat-avatar" style="${isBot ? '' : 'background:linear-gradient(135deg, #10b981 0%, #059669 100%);'}">
            <i class="fas ${isBot ? 'fa-robot' : 'fa-headset'}"></i>
          </div>
          <div class="chat-bubble">
            <div class="chat-sender-name">
              <i class="fas ${isBot ? 'fa-robot' : 'fa-headset'}"></i> 
              <span>${escapeHtml(senderTitle)}:</span>
              ${isAutoAnswer ? '<span class="badge-katalog-inquiry" style="background:#003580; color:#fff; font-size:9.5px; margin-left:6px;"><i class="fas fa-check"></i> Jawaban Resmi</span>' : ''}
            </div>
            ${quoteHtml}
            <p class="chat-text">${formattedBotText}</p>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px;">
              <button type="button" class="btn-cs-reply" onclick="handleReplyCsClick(this)" data-id="${escapeHtml(m.id || '')}" data-sender="${escapeHtml(senderTitle)}" data-text="${escapeHtml(rawSnippet)}">
                <i class="fas fa-reply"></i> Balas
              </button>
              <span class="chat-time" style="margin-top:0;">${timeFormatted}</span>
            </div>
          </div>
        </div>
      `;
    }
  });

  if (isSessionEnded) {
    html += `
      <div class="chat-system-ended-banner" style="background:#fef2f2; border:1.5px solid #fecaca; border-radius:10px; padding:16px 18px; margin:16px 8px; text-align:center; color:#991b1b; box-shadow:0 2px 8px rgba(220,38,38,0.08);">
        <div style="font-size:14px; font-weight:800; display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:6px;">
          <i class="fas fa-lock" style="color:#dc2626;"></i> Percakapan Telah Diakhiri
        </div>
        <p style="margin:0 0 12px; font-size:12.5px; color:#475569; line-height:1.5;">
          Sesi percakapan ini telah ditutup secara resmi. Tidak dapat mengirim pesan tambahan pada sesi ini. Jika Anda memerlukan bantuan atau pertanyaan baru, silakan mulai obrolan baru.
        </p>
        <button type="button" onclick="mulaiObrolanBaruCS()" class="btn-mulai-baru" style="background:#003580; color:#fff; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px; box-shadow:0 2px 6px rgba(0,53,128,0.25);">
          <i class="fas fa-plus-circle"></i> Mulai Obrolan Baru
        </button>
      </div>
    `;
  }

  box.innerHTML = html;
  box.dataset.hasRendered = 'true';

  const btnScroll = document.getElementById('csBtnScrollBottom');

  // Hanya auto-scroll ke paling bawah jika:
  // 1. Dipaksa oleh aksi user seperti kirim pesan (forceScroll = true)
  // 2. Render pertama kali saat membuka chat (isFirstRender = true)
  // 3. User memang sedang berada di paling bawah (isNearBottom = true)
  if (forceScroll || isFirstRender || isNearBottom) {
    box.scrollTop = box.scrollHeight;
    if (btnScroll) btnScroll.style.display = 'none';
  } else {
    // Pengguna sedang membaca pesan di atas: jangan paksa scroll ke bawah!
    box.scrollTop = prevScrollTop;
    if (btnScroll) btnScroll.style.display = 'inline-flex';
  }
}

function scrollCsChatToBottom() {
  const box = document.getElementById('chatStreamBox');
  if (box) {
    box.scrollTo({ top: box.scrollHeight, behavior: 'smooth' });
  }
  const btn = document.getElementById('csBtnScrollBottom');
  if (btn) btn.style.display = 'none';
}

function renderVerifiedClientCardHtml(client, messageText) {
  return `
    <div class="verified-card-bubble">
      <div class="card-bubble-header">
        <div style="display:flex; align-items:center; gap:6px;">
          <i class="fas fa-shield-alt text-success" style="color:#16a34a; font-size:15px;"></i>
          <strong>DATA KLIEN BINAAN TERVERIFIKASI</strong>
        </div>
        <span class="badge-bubble-reg"><i class="fas fa-check"></i> RESMI BAPAS</span>
      </div>
      <table class="card-bubble-table">
        <tr><th>No. Register:</th><td class="text-highlight">${escapeHtml(client.no_register || '-')}</td></tr>
        <tr><th>Nama Lengkap:</th><td style="font-weight:700;">${escapeHtml(client.nama_lengkap || '-')}</td></tr>
        <tr><th>Status Binaan:</th><td><span class="status-pill">${escapeHtml(client.status || 'aktif')}</span></td></tr>
        <tr><th>Masa Lapor:</th><td style="color:#b45309; font-weight:700;">${escapeHtml(client.masa_wajib_lapor || '-')}</td></tr>
        <tr><th>No. Telepon / HP:</th><td>${escapeHtml(client.no_telepon || '-')}</td></tr>
        <tr><th>Alamat Domisili:</th><td>${escapeHtml(client.alamat || '-')}</td></tr>
      </table>
      <div class="card-bubble-note">
        <i class="fas fa-check-circle" style="color:#16a34a;"></i>
        <span>${escapeHtml(messageText || 'Data registrasi terdeteksi langsung dari database resmi BAPAS Kelas I Medan.')}</span>
      </div>
    </div>
  `;
}

let csActiveReply = null;

function handleReplyCsClick(btn) {
  const inputPesan = document.getElementById('csInputPesan');
  if (inputPesan && inputPesan.disabled) {
    alert('Percakapan ini telah diakhiri. Tidak dapat membalas pesan.');
    return;
  }
  const msgId = btn.getAttribute('data-id') || '';
  const sender = btn.getAttribute('data-sender') || 'Pesan';
  const text = btn.getAttribute('data-text') || '';
  triggerCsReply(msgId, sender, text);
}

function triggerCsReply(msgId, sender, text) {
  csActiveReply = { id: msgId, sender: sender, text: text };
  const nameEl = document.getElementById('csReplySenderName');
  const snipEl = document.getElementById('csReplySnippetText');
  const bar = document.getElementById('csReplyPreviewBar');
  if (nameEl) nameEl.innerText = sender;
  if (snipEl) snipEl.innerText = text;
  if (bar) bar.style.display = 'flex';
  const input = document.getElementById('csInputPesan');
  if (input) {
    input.focus();
  }
}

function cancelReplyCS() {
  csActiveReply = null;
  const bar = document.getElementById('csReplyPreviewBar');
  if (bar) bar.style.display = 'none';
}

function scrollToCsQuotedMsg(elementId) {
  if (!elementId) return;
  const el = document.getElementById(elementId);
  if (el) {
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('chat-msg-highlight');
    setTimeout(() => el.classList.remove('chat-msg-highlight'), 1800);
  }
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') cancelReplyCS();
});

function startChatPolling() {
  loadChatMessages(true);
  if (!bapasChatPollTimer) {
    // Polling setiap 3 detik agar pesan respon dari admin tampil secara real-time
    bapasChatPollTimer = setInterval(() => loadChatMessages(false), 3000);
  }
}

function stopChatPolling() {
  if (bapasChatPollTimer) {
    clearInterval(bapasChatPollTimer);
    bapasChatPollTimer = null;
  }
}

// Pasang listener scroll pada chatStreamBox untuk menyembunyikan tombol floating saat user kembali ke bawah
document.addEventListener('DOMContentLoaded', () => {
  const box = document.getElementById('chatStreamBox');
  if (box) {
    box.addEventListener('scroll', () => {
      const isNearBottom = (box.scrollHeight - box.scrollTop - box.clientHeight) < 80;
      const btnScroll = document.getElementById('csBtnScrollBottom');
      if (isNearBottom && btnScroll) {
        btnScroll.style.display = 'none';
      }
    });
  }
});

async function handleKirimPesanCS(e) {
  e.preventDefault();
  const inputPesan = document.getElementById('csInputPesan');
  const btnKirim = document.getElementById('btnKirimCS');

  if (inputPesan && inputPesan.disabled) {
    alert('Percakapan ini telah diakhiri. Tidak dapat mengirim pesan lagi. Silakan klik "Mulai Obrolan Baru" untuk memulai percakapan baru.');
    return;
  }

  const pesan = (inputPesan.value || '').trim();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Pengunjung';
  const kontak = localStorage.getItem('bapas_cs_kontak') || localStorage.getItem('bapas_cs_register') || '-';
  const csType = localStorage.getItem('bapas_cs_type');
  const isVerified = csType === 'registered';
  const rawDetail = localStorage.getItem('bapas_cs_detail');
  let detailKlien = null;
  if (rawDetail) {
    try { detailKlien = JSON.parse(rawDetail); } catch (_) {}
  }
  const sId = getBapasSessionId();

  if (!pesan) return;

  btnKirim.disabled = true;
  btnKirim.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  try {
    const res = await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama,
        kontak: kontak,
        pesan: pesan,
        is_verified: isVerified,
        detail_klien: detailKlien,
        tipe_pesan: 'text',
        reply_to: csActiveReply
      })
    });
    const result = await res.json();
    if (result.success) {
      inputPesan.value = '';
      cancelReplyCS();
      loadChatMessages(true);
    } else {
      alert(result.message || 'Gagal mengirim pesan bantuan.');
    }
  } catch (err) {
    alert('Terjadi kendala jaringan saat mengirim pesan: ' + err.message);
  } finally {
    btnKirim.disabled = false;
    btnKirim.innerHTML = '<i class="fas fa-paper-plane"></i> <span class="btn-send-label">Kirim</span>';
    inputPesan.focus();
  }
}

function escapeHtml(text) {
  if (!text) return '';
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
</script>