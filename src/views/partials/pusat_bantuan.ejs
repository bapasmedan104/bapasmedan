<!-- ==============================================
     LOGIKA REAL-TIME SCRIPT PUSAT BANTUAN
     ============================================== -->
<script>
let bapasChatPollTimer = null;
let lastRenderedChatJson = '';
let verifiedClientData = null;

function getBapasSessionId() {
  let sId = localStorage.getItem('bapas_cs_session');
  if (!sId) {
    sId = 'cs_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8);
    localStorage.setItem('bapas_cs_session', sId);
  }
  return sId;
}

function initCsViewState() {
  // Jika sedang login sebagai klien binaan di portal, otomatis gunakan identitas klien (kecuali jika sedang ganti identitas)
  <% if (isLoggedIn && user && (user.no_register || userType === 'client')) { %>
    const loggedInReg = '<%= user.no_register || "" %>';
    const loggedInName = '<%= user.nama_lengkap || user.username || "Klien BAPAS" %>';
    const loggedInPhone = '<%= user.no_telepon || "-" %>';
    const isForcedSelect = localStorage.getItem('bapas_cs_force_select');
    if (!isForcedSelect && !localStorage.getItem('bapas_cs_nama') && loggedInReg) {
      localStorage.setItem('bapas_cs_type', 'registered');
      localStorage.setItem('bapas_cs_nama', loggedInName);
      localStorage.setItem('bapas_cs_register', loggedInReg);
      localStorage.setItem('bapas_cs_kontak', loggedInPhone);
    }
  <% } %>

  const csNama = localStorage.getItem('bapas_cs_nama');
  const csType = localStorage.getItem('bapas_cs_type');
  const csRegister = localStorage.getItem('bapas_cs_register');

  const prechatContainer = document.getElementById('csPrechatContainer');
  const activeChatContainer = document.getElementById('csChatActiveContainer');
  const identityPill = document.getElementById('csIdentityPill');
  const btnGanti = document.getElementById('btnGantiIdentitasCS');
  const btnKeluar = document.getElementById('btnKeluarCS');
  const btnAkhiri = document.getElementById('btnAkhiriCS');
  const quickKatalogBar = document.getElementById('csQuickKatalogBar');

  if (csNama && (csType === 'guest' || (csType === 'registered' && csRegister))) {
    // Sesi sudah memiliki identitas, buka percakapan aktif
    if (prechatContainer) prechatContainer.style.display = 'none';
    if (activeChatContainer) activeChatContainer.style.display = 'flex';
    if (identityPill) {
      identityPill.style.display = 'inline-flex';
      if (csType === 'registered') {
        identityPill.innerHTML = `<i class="fas fa-check-circle" style="color:#10b981;"></i> <span>${escapeHtml(csRegister)} (${escapeHtml(csNama)})</span>`;
        identityPill.className = 'cs-identity-pill pill-registered';
      } else {
        identityPill.innerHTML = `<i class="fas fa-user"></i> <span>${escapeHtml(csNama)}</span>`;
        identityPill.className = 'cs-identity-pill pill-guest';
      }
    }
    if (btnGanti) btnGanti.style.display = 'inline-flex';
    if (btnKeluar) btnKeluar.style.display = 'inline-flex';
    if (btnAkhiri) btnAkhiri.style.display = 'inline-flex';
    if (quickKatalogBar) {
      quickKatalogBar.style.display = (csType === 'registered') ? 'flex' : 'none';
    }
  } else {
    // Tampilkan layar pre-chat selection
    if (prechatContainer) prechatContainer.style.display = 'flex';
    if (activeChatContainer) activeChatContainer.style.display = 'none';
    if (identityPill) identityPill.style.display = 'none';
    if (btnGanti) btnGanti.style.display = 'none';
    if (btnKeluar) btnKeluar.style.display = 'none';
    if (btnAkhiri) btnAkhiri.style.display = 'none';
    if (quickKatalogBar) quickKatalogBar.style.display = 'none';
  }
}

function gantiIdentitasCS() {
  if (!confirm('Apakah Anda ingin mengganti identitas obrolan Customer Service? Anda dapat memilih masuk sebagai Klien Binaan lain atau Pengunjung Umum.')) {
    return;
  }
  // Tandai flag force_select agar sesi login tidak langsung mengisi identitas lama
  localStorage.setItem('bapas_cs_force_select', 'true');
  localStorage.removeItem('bapas_cs_type');
  localStorage.removeItem('bapas_cs_nama');
  localStorage.removeItem('bapas_cs_register');
  localStorage.removeItem('bapas_cs_kontak');
  localStorage.removeItem('bapas_cs_detail');
  localStorage.removeItem('bapas_cs_session');
  stopChatPolling();
  lastRenderedChatJson = '';
  verifiedClientData = null;

  // Bersihkan input formulir
  const inputReg = document.getElementById('inputCsNoRegister');
  if (inputReg) inputReg.value = '';
  const inputGuest = document.getElementById('inputCsNamaGuest');
  if (inputGuest) inputGuest.value = '';
  const inputGuestPhone = document.getElementById('inputCsKontakGuest');
  if (inputGuestPhone) inputGuestPhone.value = '';

  const alertRegErr = document.getElementById('alertRegisterError');
  if (alertRegErr) { alertRegErr.style.display = 'none'; alertRegErr.innerHTML = ''; }
  const previewBox = document.getElementById('previewRegisterSuccess');
  if (previewBox) { previewBox.style.display = 'none'; }
  const alertGuestErr = document.getElementById('alertGuestError');
  if (alertGuestErr) { alertGuestErr.style.display = 'none'; alertGuestErr.innerHTML = ''; }

  initCsViewState();
  selectCsOption('registered');
}

function keluarPercakapanCS() {
  // Tutup antarmuka Pusat Bantuan tanpa menghapus obrolan
  tutupPusatBantuan();
}

async function akhiriPercakapanCS() {
  if (!confirm('Apakah Anda yakin ingin mengakhiri sesi percakapan Customer Service ini? Percakapan yang sedang berjalan akan diselesaikan.')) {
    return;
  }
  const sId = getBapasSessionId();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Pengguna';
  
  try {
    await fetch('/api/pusat-bantuan/akhiri', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama,
        pesan: `[SESI SELESAI] Sesi percakapan bantuan telah diselesaikan oleh ${nama}.`
      })
    });
  } catch (err) {
    console.warn('Gagal memproses akhir sesi:', err);
  }

  stopChatPolling();
  localStorage.setItem('bapas_cs_force_select', 'true');
  localStorage.removeItem('bapas_cs_session');
  localStorage.removeItem('bapas_cs_nama');
  localStorage.removeItem('bapas_cs_register');
  localStorage.removeItem('bapas_cs_kontak');
  localStorage.removeItem('bapas_cs_detail');
  localStorage.removeItem('bapas_cs_type');
  lastRenderedChatJson = '';
  verifiedClientData = null;
  initCsViewState();
  selectCsOption('registered');
}

function resetCsSession() {
  gantiIdentitasCS();
}

function selectCsOption(type) {
  const cardReg = document.getElementById('cardOptRegister');
  const cardGuest = document.getElementById('cardOptGuest');
  const panelReg = document.getElementById('panelFormRegister');
  const panelGuest = document.getElementById('panelFormGuest');

  if (type === 'registered') {
    if (cardReg) cardReg.classList.add('active');
    if (cardGuest) cardGuest.classList.remove('active');
    if (panelReg) panelReg.style.display = 'block';
    if (panelGuest) panelGuest.style.display = 'none';
    const inputReg = document.getElementById('inputCsNoRegister');
    if (inputReg) setTimeout(() => inputReg.focus(), 100);
  } else {
    if (cardGuest) cardGuest.classList.add('active');
    if (cardReg) cardReg.classList.remove('active');
    if (panelGuest) panelGuest.style.display = 'block';
    if (panelReg) panelReg.style.display = 'none';
    const inputGuest = document.getElementById('inputCsNamaGuest');
    if (inputGuest) setTimeout(() => inputGuest.focus(), 100);
  }
}

async function verifikasiNoRegister() {
  const input = document.getElementById('inputCsNoRegister');
  const val = (input ? input.value : '').trim();
  const alertErr = document.getElementById('alertRegisterError');
  const previewBox = document.getElementById('previewRegisterSuccess');
  const previewDetails = document.getElementById('previewRegisterDetails');
  const btn = document.getElementById('btnCekRegister');

  if (alertErr) {
    alertErr.style.display = 'none';
    alertErr.innerHTML = '';
  }
  if (previewBox) previewBox.style.display = 'none';

  if (!val) {
    if (alertErr) {
      alertErr.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Harap masukkan nomor registrasi klien Anda (contoh: REG-2026).';
      alertErr.style.display = 'flex';
    }
    if (input) input.focus();
    return;
  }

  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Memeriksa...</span>';
  }

  try {
    const res = await fetch('/api/pusat-bantuan/cek-registrasi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ no_register: val })
    });
    const data = await res.json();
    if (!data.success) {
      if (alertErr) {
        alertErr.innerHTML = `<i class="fas fa-times-circle"></i> <span>${escapeHtml(data.message || 'Gagal memeriksa nomor register.')}</span>`;
        alertErr.style.display = 'flex';
      }
    } else if (!data.found) {
      if (alertErr) {
        alertErr.innerHTML = `
          <i class="fas fa-times-circle" style="font-size:18px; margin-top:2px;"></i>
          <div>
            <strong>Nomor Register Tidak Ditemukan</strong><br>
            ${escapeHtml(data.message)}<br>
            <small style="display:inline-block; margin-top:5px; color:#b91c1c;">
              Jika Anda adalah pengunjung atau masyarakat umum, silakan pilih kartu <strong>Belum Punya Nomor Registrasi</strong> di atas.
            </small>
          </div>
        `;
        alertErr.style.display = 'flex';
      }
    } else {
      // Data klien ditemukan
      verifiedClientData = data.client;
      if (previewDetails) {
        previewDetails.innerHTML = `
          <table class="preview-details-table">
            <tr><th>No. Registrasi:</th><td style="color:#003580; font-weight:800; font-size:14px;">${escapeHtml(data.client.no_register)}</td></tr>
            <tr><th>Nama Lengkap:</th><td style="font-weight:700;">${escapeHtml(data.client.nama_lengkap)}</td></tr>
            <tr><th>Status Binaan:</th><td><span class="badge-status-aktif">${escapeHtml(data.client.status)}</span></td></tr>
            <tr><th>Masa Wajib Lapor:</th><td style="color:#b45309; font-weight:700;">${escapeHtml(data.client.masa_wajib_lapor)}</td></tr>
            <tr><th>Kontak / Telp:</th><td>${escapeHtml(data.client.no_telepon)}</td></tr>
            <tr><th>Alamat Domisili:</th><td>${escapeHtml(data.client.alamat)}</td></tr>
          </table>
          <div style="margin-top:10px; font-size:12px; color:#15803d; font-style:italic;">
            <i class="fas fa-shield-alt"></i> Data ini akan otomatis disampaikan ke ruang percakapan Customer Service BAPAS Medan.
          </div>
        `;
      }
      if (previewBox) previewBox.style.display = 'block';
    }
  } catch (err) {
    if (alertErr) {
      alertErr.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Terjadi kesalahan jaringan saat memverifikasi: ${escapeHtml(err.message)}`;
      alertErr.style.display = 'flex';
    }
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-search"></i> <span>Periksa Data</span>';
    }
  }
}

async function mulaiChatTerverifikasi() {
  if (!verifiedClientData) {
    alert('Silakan lakukan pemeriksaan nomor registrasi terlebih dahulu.');
    return;
  }

  const sId = getBapasSessionId();
  const client = verifiedClientData;

  localStorage.removeItem('bapas_cs_force_select');
  localStorage.setItem('bapas_cs_type', 'registered');
  localStorage.setItem('bapas_cs_nama', client.nama_lengkap);
  localStorage.setItem('bapas_cs_register', client.no_register);
  localStorage.setItem('bapas_cs_kontak', client.no_telepon || client.no_register);
  localStorage.setItem('bapas_cs_detail', JSON.stringify(client));

  // Tampilkan layar chat aktif
  initCsViewState();

  // Kirimkan kartu verifikasi data registrasi klien ke log percakapan
  try {
    await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: client.nama_lengkap,
        kontak: client.no_telepon || client.no_register,
        pesan: `[KLIEN TERVERIFIKASI RESMI] Halo Customer Service BAPAS Medan, data bimbingan saya dengan No. Register ${client.no_register} telah terverifikasi resmi oleh sistem.`,
        is_verified: true,
        tipe_pesan: 'client_card',
        detail_klien: client
      })
    });
  } catch (e) {
    console.warn('Gagal memposting data verifikasi awal:', e);
  }

  // Kirimkan pesan sambutan sekaligus Katalog Bantuan Cepat interaktif
  try {
    await fetch('/api/pusat-bantuan/bot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        pesan: `Halo ${client.nama_lengkap}! Identitas registrasi Anda (${client.no_register}) telah terverifikasi resmi oleh sistem BAPAS Medan. Silakan pilih topik kendala atau pertanyaan yang Anda butuhkan melalui Katalog Bantuan Cepat di bawah ini:`,
        topik: 'welcome',
        detail_klien: client
      })
    });
  } catch (e) {
    console.warn('Gagal memposting katalog bot awal:', e);
  }

  startChatPolling();
}

function mulaiChatPengunjung() {
  const inputNama = document.getElementById('inputCsNamaGuest');
  const inputKontak = document.getElementById('inputCsKontakGuest');
  const alertErr = document.getElementById('alertGuestError');

  if (alertErr) alertErr.style.display = 'none';

  const nama = (inputNama ? inputNama.value : '').trim();
  const kontak = (inputKontak ? inputKontak.value : '').trim();

  if (!nama) {
    if (alertErr) {
      alertErr.innerHTML = '<i class="fas fa-exclamation-circle"></i> Harap masukkan Nama Lengkap Anda terlebih dahulu.';
      alertErr.style.display = 'flex';
    }
    if (inputNama) inputNama.focus();
    return;
  }

  localStorage.removeItem('bapas_cs_force_select');
  localStorage.setItem('bapas_cs_type', 'guest');
  localStorage.setItem('bapas_cs_nama', nama);
  localStorage.setItem('bapas_cs_kontak', kontak || '-');
  localStorage.removeItem('bapas_cs_register');
  localStorage.removeItem('bapas_cs_detail');

  initCsViewState();
  startChatPolling();
}

async function pilihTopikKatalog(topikKey) {
  const sId = getBapasSessionId();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Klien BAPAS';
  const noReg = localStorage.getItem('bapas_cs_register') || '-';
  const kontak = localStorage.getItem('bapas_cs_kontak') || noReg;
  const rawDetail = localStorage.getItem('bapas_cs_detail');
  let detailKlien = null;
  if (rawDetail) {
    try { detailKlien = JSON.parse(rawDetail); } catch (_) {}
  }

  let topikTitle = '';
  let botAnswer = '';

  switch (topikKey) {
    case 'lupa_sandi':
      topikTitle = 'Lupa Sandi Login Klien';
      botAnswer = `🔑 PANDUAN PEMULIHAN KATA SANDI PORTAL KLIEN:\n\n1. Pemulihan Mandiri:\nKunjungi halaman Lupa Sandi di Portal Klien (https://bapas1medan.com/client/lupa-sandi). Masukkan No. Register (${noReg}) atau Username Anda, lalu ikuti instruksi reset sandi.\n\n2. Bantuan Reset oleh Petugas CS:\nJika Anda mengalami kendala saat reset mandiri, Petugas Administrator kami di panel Customer Service dapat mereset kata sandi Anda ke sandi default bimbingan.\n\nNotifikasi kebutuhan reset sandi Anda telah disampaikan ke petugas kami. Petugas akan segera membalas percakapan Anda di sini.`;
      break;

    case 'kendala_kamera':
      topikTitle = 'Kendala Kamera / Presensi Foto Wajib Lapor';
      botAnswer = `📷 PANDUAN MENGATASI KENDALA KAMERA WAJIB LAPOR:\n\n1. Izin Kamera Browser:\nPastikan izin akses kamera pada browser (Chrome / Safari) telah diizinkan ('Allow'). Jika diblokir, ketuk ikon gembok pada URL bar > Izin Situs > Kamera > Izinkan.\n\n2. Ketentuan Bukti Foto:\nDemi integritas dan keabsahan pelaporan bimbingan, sistem BAPAS Kelas I Medan mewajibkan pengambilan foto langsung melalui kamera (fitur unggah galeri dinonaktifkan). Pastikan wajah terlihat jelas dan pencahayaan memadai.\n\n3. Jika Kamera Tidak Terbuka:\nTutup tab lain atau aplikasi yang sedang menggunakan kamera, lalu muat ulang halaman. Petugas kami siap membantu jika kendala berlanjut.`;
      break;

    case 'jadwal_lapor':
      topikTitle = 'Jadwal & Periode Wajib Lapor Bulan Ini';
      botAnswer = `📅 INFORMASI JADWAL WAJIB LAPOR KLIEN:\n\n1. Periode Pembukaan Layanan:\nLayanan Wajib Lapor Online dibuka setiap bulan sesuai rentang tanggal pengumuman resmi yang tertera pada Beranda (https://bapas1medan.com/).\n\n2. Ketentuan Pelaporan:\nKlien Binaan aktif wajib melapor 1 (satu) kali setiap bulan bimbingan yang sedang berjalan.\n\n3. Syarat Pelaporan:\nPastikan Anda telah melengkapi Profil Klien (alamat domisili, nomor HP aktif, masa wajib lapor, dan foto profil terbaru) sebelum mengisi formulir wajib lapor.`;
      break;

    case 'litmas_integrasi':
      topikTitle = 'Layanan Litmas & Integrasi (PB/CB/CMB)';
      botAnswer = `⚖️ INFORMASI LAYANAN LITMAS & PROGRAM INTEGRASI:\n\n1. Pelayanan GRATIS (Rp 0 / Nol Pungli):\nSeluruh pelayanan bimbingan kemasyarakatan, pembuatan Litmas (Penelitian Kemasyarakatan), serta program Pembebasan Bersyarat (PB), Cuti Bersyarat (CB), Cuti Menjelang Bebas (CMB), dan Asimilasi di BAPAS Kelas I Medan adalah GRATIS tanpa dipungut biaya apapun.\n\n2. Konsultasi Berkas & Pembimbing Kemasyarakatan (PK):\nUntuk menanyakan perkembangan berkas integrasi atau nama PK pembimbing Anda, silakan ketik pertanyaan spesifik Anda di kolom pesan di bawah.`;
      break;

    case 'chat_petugas':
      topikTitle = 'Hubungi Petugas CS Langsung';
      botAnswer = `💬 LAYANAN PERCAKAPAN LANGSUNG DENGAN PETUGAS:\n\nPesan konsultasi Anda telah diteruskan ke Petugas Customer Service BAPAS Kelas I Medan yang sedang bertugas.\nSilakan ketikkan pertanyaan atau kendala bimbingan Anda secara lengkap pada kolom chat di bawah. Petugas kami akan segera merespons percakapan Anda.`;
      break;

    default:
      topikTitle = topikKey;
      botAnswer = 'Pertanyaan Anda telah kami terima dan diteruskan ke Petugas Customer Service BAPAS Medan.';
  }

  // 1. Kirim pesan pertanyaan pengguna ke log chat
  try {
    await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama,
        kontak: kontak,
        pesan: `[KATALOG BANTUAN] Saya memerlukan bantuan mengenai: ${topikTitle}`,
        is_verified: true,
        detail_klien: detailKlien,
        tipe_pesan: 'katalog_inquiry'
      })
    });
  } catch (err) {
    console.warn('Gagal mengirim permintaan topik katalog:', err);
  }

  // 2. Kirim respon resmi bot
  try {
    await fetch('/api/pusat-bantuan/bot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        pesan: botAnswer,
        topik: topikKey,
        detail_klien: detailKlien
      })
    });
  } catch (err) {
    console.warn('Gagal mengirim jawaban bot katalog:', err);
  }

  // Segarkan pesan percakapan
  loadChatMessages();
}

function bukaPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    initCsViewState();
    
    // Jika tab CS sedang aktif dan identitas sudah dipilih, mulai polling chat
    if (document.getElementById('kategoriCS').classList.contains('active')) {
      const nama = localStorage.getItem('bapas_cs_nama');
      if (nama) {
        startChatPolling();
      }
    }
  }
}

function tutupPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
  stopChatPolling();
}

function switchKategoriBantuan(kat) {
  const btnLangkah = document.getElementById('tabHeadLangkah');
  const btnCS = document.getElementById('tabHeadCS');
  const paneLangkah = document.getElementById('kategoriLangkah');
  const paneCS = document.getElementById('kategoriCS');

  if (kat === 'langkah') {
    btnLangkah.classList.add('active');
    btnCS.classList.remove('active');
    paneLangkah.classList.add('active');
    paneCS.classList.remove('active');
    stopChatPolling();
  } else {
    btnCS.classList.add('active');
    btnLangkah.classList.remove('active');
    paneCS.classList.add('active');
    paneLangkah.classList.remove('active');
    initCsViewState();
    const nama = localStorage.getItem('bapas_cs_nama');
    if (nama) {
      startChatPolling();
    }
  }
}

async function loadChatMessages() {
  const sId = getBapasSessionId();
  try {
    const res = await fetch('/api/pusat-bantuan/pesan/' + sId);
    if (!res.ok) return;
    const data = await res.json();
    if (data.success && Array.isArray(data.data)) {
      const currentJson = JSON.stringify(data.data);
      if (currentJson !== lastRenderedChatJson) {
        lastRenderedChatJson = currentJson;
        renderChatStream(data.data);
      }
    }
  } catch (err) {
    console.warn('Gagal memuat pesan chat bantuan:', err);
  }
}

function renderChatStream(messages) {
  const box = document.getElementById('chatStreamBox');
  if (!box) return;

  const currentCsNama = (localStorage.getItem('bapas_cs_nama') || '').trim().toLowerCase();
  const currentCsRegister = (localStorage.getItem('bapas_cs_register') || '').trim();

  let html = `
    <div class="chat-msg chat-msg-bot">
      <div class="chat-avatar"><i class="fas fa-robot"></i></div>
      <div class="chat-bubble">
        <div class="chat-sender-name"><i class="fas fa-robot"></i> Asisten Layanan BAPAS:</div>
        <p class="chat-text">Halo! Selamat datang di Customer Service Resmi BAPAS Kelas I Medan. Silakan tuliskan kendala login, pertanyaan wajib lapor, atau permohonan informasi Anda di bawah ini. Petugas kami siap merespons secara real-time.</p>
        <span class="chat-time">Respon Otomatis</span>
      </div>
    </div>
  `;

  messages.forEach(m => {
    // 1. Session Ended Message
    if (m.tipe_pesan === 'session_ended') {
      html += `
        <div class="chat-system-ended-banner">
          <i class="fas fa-flag-checkered" style="color:#10b981;"></i>
          <span>${escapeHtml(m.pesan)}</span>
        </div>
      `;
      return;
    }

    // 2. Interactive Welcome Catalog Card
    if (m.tipe_pesan === 'katalog_welcome') {
      const timeFormatted = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' }) : '';
      html += `
        <div class="chat-msg chat-msg-bot chat-msg-katalog">
          <div class="chat-avatar" style="background:linear-gradient(135deg, #003580 0%, #001938 100%);"><i class="fas fa-robot"></i></div>
          <div class="chat-bubble chat-bubble-katalog">
            <div class="chat-sender-name"><i class="fas fa-robot"></i> Asisten Virtual BAPAS Kelas I Medan:</div>
            <p class="chat-text" style="color:#0f172a; margin-bottom:10px;">${escapeHtml(m.pesan)}</p>
            <div class="katalog-options-grid">
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('lupa_sandi')">
                <div class="katalog-opt-icon icon-key"><i class="fas fa-key"></i></div>
                <div class="katalog-opt-text">
                  <strong>1. Lupa Sandi Login Klien</strong>
                  <small>Panduan reset kata sandi mandiri atau bantuan reset oleh petugas CS</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('kendala_kamera')">
                <div class="katalog-opt-icon icon-camera"><i class="fas fa-camera"></i></div>
                <div class="katalog-opt-text">
                  <strong>2. Kendala Kamera / Presensi Foto</strong>
                  <small>Solusi izin kamera browser dan panduan pengambilan foto bukti lapor</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('jadwal_lapor')">
                <div class="katalog-opt-icon icon-calendar"><i class="fas fa-calendar-alt"></i></div>
                <div class="katalog-opt-text">
                  <strong>3. Jadwal &amp; Periode Wajib Lapor</strong>
                  <small>Rentang tanggal buka layanan lapor online dan ketentuan lapor bulanan</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('litmas_integrasi')">
                <div class="katalog-opt-icon icon-litmas"><i class="fas fa-balance-scale"></i></div>
                <div class="katalog-opt-text">
                  <strong>4. Layanan Litmas &amp; Integrasi (PB/CB/CMB)</strong>
                  <small>Informasi pengurusan bimbingan dan layanan integrasi 100% GRATIS</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('chat_petugas')">
                <div class="katalog-opt-icon icon-headset"><i class="fas fa-headset"></i></div>
                <div class="katalog-opt-text">
                  <strong>5. Hubungi Petugas CS Langsung</strong>
                  <small>Konsultasi langsung dengan petugas Customer Service BAPAS Medan</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
            </div>
            <span class="chat-time">${timeFormatted} &bull; Katalog Bantuan Interaktif</span>
          </div>
        </div>
      `;
      return;
    }

    const isBot = m.pengirim === 'bot' || m.nama === 'Asisten Layanan BAPAS';
    let isUser = false;
    if (!isBot) {
      if (m.pengirim === 'user' || m.tipe_pesan === 'client_card') {
        isUser = true;
      } else if (currentCsNama && m.nama && m.nama.trim().toLowerCase() === currentCsNama) {
        isUser = true;
      }
    }

    const timeFormatted = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' }) : '';

    if (isUser) {
      let contentHtml = '';
      if (m.tipe_pesan === 'client_card') {
        let clientData = m.detail_klien;
        if (!clientData) {
          try {
            clientData = JSON.parse(localStorage.getItem('bapas_cs_detail'));
          } catch (_) {}
        }
        if (!clientData) {
          clientData = {
            no_register: currentCsRegister || m.kontak || '-',
            nama_lengkap: m.nama,
            status: 'aktif',
            masa_wajib_lapor: 'Terdaftar di BAPAS Medan',
            no_telepon: m.kontak || '-',
            alamat: '-'
          };
        }
        contentHtml = renderVerifiedClientCardHtml(clientData, m.pesan);
      } else {
        const isKatalogInquiry = m.tipe_pesan === 'katalog_inquiry';
        contentHtml = `<p class="chat-text">${isKatalogInquiry ? '<span class="badge-katalog-inquiry"><i class="fas fa-bolt"></i> Bantuan Cepat</span>' : ''}${escapeHtml(m.pesan)}</p>`;
      }

      const displayName = m.nama || localStorage.getItem('bapas_cs_nama') || 'Anda';
      const isReg = m.is_verified || Boolean(m.detail_klien) || Boolean(currentCsRegister);

      html += `
        <div class="chat-msg chat-msg-user">
          <div class="chat-bubble">
            <div class="chat-sender-name-user">
              <i class="fas ${isReg ? 'fa-id-badge' : 'fa-user-circle'}"></i> 
              <span>${escapeHtml(displayName)}</span>
              ${isReg ? '<span class="bubble-tag-verified"><i class="fas fa-check-circle"></i> Terverifikasi</span>' : ''}
            </div>
            ${contentHtml}
            <span class="chat-time">${timeFormatted} &bull; Terkirim</span>
          </div>
        </div>
      `;
    } else {
      const senderTitle = isBot ? 'Asisten Layanan BAPAS' : (m.admin_name || m.nama || 'Petugas CS BAPAS');
      const isAutoAnswer = m.tipe_pesan && m.tipe_pesan.startsWith('katalog_jawaban');
      const formattedBotText = escapeHtml(m.pesan).replace(/\n/g, '<br>');

      html += `
        <div class="chat-msg ${isBot ? 'chat-msg-bot' : 'chat-msg-admin'}">
          <div class="chat-avatar" style="${isBot ? '' : 'background:linear-gradient(135deg, #10b981 0%, #059669 100%);'}">
            <i class="fas ${isBot ? 'fa-robot' : 'fa-headset'}"></i>
          </div>
          <div class="chat-bubble">
            <div class="chat-sender-name">
              <i class="fas ${isBot ? 'fa-robot' : 'fa-headset'}"></i> 
              <span>${escapeHtml(senderTitle)}:</span>
              ${isAutoAnswer ? '<span class="badge-katalog-inquiry" style="background:#003580; color:#fff; font-size:9.5px; margin-left:6px;"><i class="fas fa-check"></i> Jawaban Resmi</span>' : ''}
            </div>
            <p class="chat-text">${formattedBotText}</p>
            <span class="chat-time">${timeFormatted}</span>
          </div>
        </div>
      `;
    }
  });

  box.innerHTML = html;
  box.scrollTop = box.scrollHeight;
}

function renderVerifiedClientCardHtml(client, messageText) {
  return `
    <div class="verified-card-bubble">
      <div class="card-bubble-header">
        <div style="display:flex; align-items:center; gap:6px;">
          <i class="fas fa-shield-alt text-success" style="color:#16a34a; font-size:15px;"></i>
          <strong>DATA KLIEN BINAAN TERVERIFIKASI</strong>
        </div>
        <span class="badge-bubble-reg"><i class="fas fa-check"></i> RESMI BAPAS</span>
      </div>
      <table class="card-bubble-table">
        <tr><th>No. Register:</th><td class="text-highlight">${escapeHtml(client.no_register || '-')}</td></tr>
        <tr><th>Nama Lengkap:</th><td style="font-weight:700;">${escapeHtml(client.nama_lengkap || '-')}</td></tr>
        <tr><th>Status Binaan:</th><td><span class="status-pill">${escapeHtml(client.status || 'aktif')}</span></td></tr>
        <tr><th>Masa Lapor:</th><td style="color:#b45309; font-weight:700;">${escapeHtml(client.masa_wajib_lapor || '-')}</td></tr>
        <tr><th>No. Telepon / HP:</th><td>${escapeHtml(client.no_telepon || '-')}</td></tr>
        <tr><th>Alamat Domisili:</th><td>${escapeHtml(client.alamat || '-')}</td></tr>
      </table>
      <div class="card-bubble-note">
        <i class="fas fa-check-circle" style="color:#16a34a;"></i>
        <span>${escapeHtml(messageText || 'Data registrasi terdeteksi langsung dari database resmi BAPAS Kelas I Medan.')}</span>
      </div>
    </div>
  `;
}

function startChatPolling() {
  loadChatMessages();
  if (!bapasChatPollTimer) {
    // Polling setiap 3 detik agar pesan respon dari admin tampil secara real-time
    bapasChatPollTimer = setInterval(loadChatMessages, 3000);
  }
}

function stopChatPolling() {
  if (bapasChatPollTimer) {
    clearInterval(bapasChatPollTimer);
    bapasChatPollTimer = null;
  }
}

async function handleKirimPesanCS(e) {
  e.preventDefault();
  const inputPesan = document.getElementById('csInputPesan');
  const btnKirim = document.getElementById('btnKirimCS');

  const pesan = (inputPesan.value || '').trim();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Pengunjung';
  const kontak = localStorage.getItem('bapas_cs_kontak') || localStorage.getItem('bapas_cs_register') || '-';
  const csType = localStorage.getItem('bapas_cs_type');
  const isVerified = csType === 'registered';
  const rawDetail = localStorage.getItem('bapas_cs_detail');
  let detailKlien = null;
  if (rawDetail) {
    try { detailKlien = JSON.parse(rawDetail); } catch (_) {}
  }
  const sId = getBapasSessionId();

  if (!pesan) return;

  btnKirim.disabled = true;
  btnKirim.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  try {
    const res = await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama,
        kontak: kontak,
        pesan: pesan,
        is_verified: isVerified,
        detail_klien: detailKlien,
        tipe_pesan: 'text'
      })
    });
    const result = await res.json();
    if (result.success) {
      inputPesan.value = '';
      loadChatMessages();
    } else {
      alert(result.message || 'Gagal mengirim pesan bantuan.');
    }
  } catch (err) {
    alert('Terjadi kendala jaringan saat mengirim pesan: ' + err.message);
  } finally {
    btnKirim.disabled = false;
    btnKirim.innerHTML = '<i class="fas fa-paper-plane"></i> <span class="btn-send-label">Kirim</span>';
    inputPesan.focus();
  }
}

function escapeHtml(text) {
  if (!text) return '';
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
</script>