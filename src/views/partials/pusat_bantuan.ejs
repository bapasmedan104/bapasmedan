  display: flex;
  flex-direction: column;
  position: relative;
}
.prechat-option-card:hover {
  border-color: #94a3b8;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
}
.prechat-option-card.active {
  border-color: #003580;
  background: #f8fafc;
  box-shadow: 0 8px 20px rgba(0, 53, 128, 0.12);
}
.prechat-opt-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.prechat-opt-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.prechat-opt-icon.icon-reg {
  background: #e0f2fe;
  color: #0284c7;
}
.prechat-opt-icon.icon-guest {
  background: #fef3c7;
  color: #d97706;
}
.prechat-opt-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10.5px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 10px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin-bottom: 2px;
}
.prechat-opt-tag.tag-reg {
  background: #dcfce7;
  color: #15803d;
}
.prechat-opt-tag.tag-guest {
  background: #fef3c7;
  color: #92400e;
}
.prechat-opt-title {
  margin: 0;
  font-size: 14.5px;
  font-weight: 700;
  color: #0f172a;
}
.prechat-opt-text {
  margin: 0 0 12px;
  font-size: 12.5px;
  color: #64748b;
  line-height: 1.5;
  flex: 1;
}
.prechat-opt-select-indicator {
  font-size: 11.5px;
  font-weight: 700;
  color: #003580;
  display: none;
  align-items: center;
  gap: 4px;
}
.prechat-option-card.active .prechat-opt-select-indicator {
  display: flex;
}

/* Pre-Chat Form Boxes */
.prechat-form-box {
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
.prechat-form-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
  border-bottom: 1px solid #f1f5f9;
  padding-bottom: 12px;
}
.prechat-form-header strong {
  display: block;
  font-size: 14.5px;
  color: #0f172a;
  margin-bottom: 2px;
}
.prechat-form-header p {
  margin: 0;
  font-size: 12.5px;
  color: #64748b;
  line-height: 1.45;
}
.text-reg-icon {
  font-size: 24px;
  color: #0284c7;
  flex-shrink: 0;
  margin-top: 2px;
}
.text-guest-icon {
  font-size: 24px;
  color: #f59e0b;
  flex-shrink: 0;
  margin-top: 2px;
}
.prechat-label {
  font-size: 13px;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 6px;
}
.prechat-input-action-row {
  display: flex;
  gap: 10px;
  align-items: center;
}
.prechat-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
}
.prechat-input-wrapper .input-icon {
  position: absolute;
  left: 14px;
  color: #64748b;
  font-size: 14px;
  pointer-events: none;
}
.prechat-text-input {
  width: 100%;
  padding: 12px 14px 12px 38px;
  border: 1.5px solid #cbd5e1;
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  color: #1e293b;
  background: #f8fafc;
  box-sizing: border-box;
  transition: all 0.2s;
}
.prechat-text-input:focus {
  outline: none;
  border-color: #003580;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(0, 53, 128, 0.12);
}
.btn-prechat-action {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 12px 20px;
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  font-family: inherit;
  box-shadow: 0 3px 10px rgba(0, 53, 128, 0.2);
  transition: all 0.2s;
  flex-shrink: 0;
}
.btn-prechat-action:hover {
  background: #001938;
  transform: translateY(-1px);
}
.prechat-help-text {
  display: block;
  font-size: 11.5px;
  color: #64748b;
  margin-top: 6px;
}
.prechat-alert-error {
  margin-top: 14px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-left: 4px solid #ef4444;
  border-radius: 0 8px 8px 0;
  padding: 12px 16px;
  color: #991b1b;
  font-size: 13px;
  line-height: 1.5;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.prechat-verified-preview {
  margin-top: 16px;
  background: #f0fdf4;
  border: 1.5px solid #86efac;
  border-radius: 10px;
  padding: 16px;
  animation: fadeInFullscreen 0.25s ease-out;
}
.verified-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #bbf7d0;
  padding-bottom: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
}
.badge-terverifikasi {
  background: #16a34a;
  color: #ffffff;
  font-size: 10.5px;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 20px;
  letter-spacing: 0.3px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.preview-details-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  color: #1e293b;
}
.preview-details-table th {
  width: 140px;
  text-align: left;
  font-weight: 600;
  color: #475569;
  padding: 6px 0;
}
.preview-details-table td {
  padding: 6px 0;
}
.badge-status-aktif {
  background: #dbeafe;
  color: #1e40af;
  font-size: 11.5px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 12px;
  text-transform: uppercase;
}
.btn-confirm-chat {
  background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 12px 22px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: inherit;
  box-shadow: 0 3px 10px rgba(22, 163, 74, 0.25);
  transition: all 0.2s;
}
.btn-confirm-chat:hover {
  background: #14532d;
  transform: translateY(-1px);
}
.btn-guest-confirm {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  box-shadow: 0 3px 10px rgba(0, 53, 128, 0.25);
}
.btn-guest-confirm:hover {
  background: #001938;
}
.prechat-guest-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

/* ACTIVE CHAT WRAPPER */
.cs-active-chat-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0 !important;
  width: 100% !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
}

/* Chat Stream */
.cs-chat-stream {
  flex: 1;
  min-height: 0;
  min-width: 0 !important;
  width: 100% !important;
  background: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 18px;
  overflow-y: auto;
  overflow-x: hidden !important;
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 12px;
  box-sizing: border-box !important;
}
.cs-btn-scroll-bottom {
  position: absolute;
  bottom: 80px;
  right: 24px;
  z-index: 90;
  background: #003580;
  color: #ffffff;
  border: 1.5px solid #60a5fa;
  border-radius: 50px;
  padding: 6px 14px;
  font-size: 11.5px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(0, 53, 128, 0.4);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
  animation: csBounceIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.cs-btn-scroll-bottom:hover {
  background: #002255;
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 53, 128, 0.55);
}
@keyframes csBounceIn {
  from { opacity: 0; transform: translateY(12px) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.chat-msg {
  display: flex;
  gap: 10px;
  max-width: 85%;
  min-width: 0 !important;
  box-sizing: border-box !important;
}
.chat-msg-bot, .chat-msg-admin {
  align-self: flex-start;
  margin-right: auto;
}
.chat-msg-user {
  align-self: flex-end;
  margin-left: auto;
  flex-direction: row-reverse;
}
.chat-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #003580;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.chat-bubble {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 14px;
  line-height: 1.55;
  color: #1e293b;
  box-shadow: 0 2px 6px rgba(0,0,0,0.04);
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
  word-break: break-word !important;
  overflow-wrap: anywhere !important;
  overflow: hidden !important;
}
.chat-msg-user .chat-bubble {
  background: linear-gradient(135deg, #003580 0%, #002255 100%);
  color: #ffffff;
  border-color: #003580;
  border-bottom-right-radius: 2px;
}
.chat-msg-bot .chat-bubble {
  border-left: 4px solid #003580;
  border-bottom-left-radius: 2px;
}
.chat-msg-admin .chat-bubble {
  border-left: 4px solid #16a34a;
  border-bottom-left-radius: 2px;
}
.chat-sender-name {
  font-weight: 700;
  font-size: 12px;
  color: #003580;
  margin-bottom: 4px;
}
.chat-msg-admin .chat-sender-name {
  color: #15803d;
}
.chat-sender-name-user {
  font-size: 12px;
  font-weight: 700;
  color: #fde68a;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.bubble-tag-verified {
  background: #10b981;
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  padding: 1px 7px;
  border-radius: 10px;
}
.chat-text {
  margin: 0;
  font-size: 14px;
  word-break: break-word;
}
.chat-time {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-top: 6px;
  text-align: right;
}
.chat-msg-user .chat-time {
  color: #cbd5e1;
}

/* Verified Client Detail Card in Chat Bubble */
.verified-card-bubble {
  background: #f0fdf4;
  border: 1.5px solid #86efac;
  border-radius: 8px;
  padding: 12px 14px;
