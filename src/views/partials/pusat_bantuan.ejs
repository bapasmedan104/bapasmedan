/* PRE-CHAT SCREEN */
.cs-prechat-screen {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-bottom: 20px;
}
.prechat-hero-banner {
  background: linear-gradient(135deg, #eff6ff 0%, #e0e7ff 100%);
  border: 1px solid #bfdbfe;
  border-radius: 12px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.prechat-banner-icon {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: #003580;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
  box-shadow: 0 4px 10px rgba(0, 53, 128, 0.25);
}
.prechat-banner-title {
  margin: 0 0 4px;
  font-size: 16px;
  font-weight: 800;
  color: #002255;
}
.prechat-banner-desc {
  margin: 0;
  font-size: 13px;
  color: #334155;
  line-height: 1.5;
}

/* Pre-Chat Cards Grid */
.prechat-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.prechat-option-card {
  background: #ffffff;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  padding: 18px;
