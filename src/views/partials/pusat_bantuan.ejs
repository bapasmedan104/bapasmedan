async function pilihTopikKatalog(topikKey) {
  const inputPesan = document.getElementById('csInputPesan');
  if (inputPesan && inputPesan.disabled) {
    alert('Percakapan telah diakhiri. Tidak dapat mengirim pesan lagi. Silakan klik "Mulai Obrolan Baru" untuk memulai percakapan baru.');
    return;
  }
  const sId = getBapasSessionId();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Klien BAPAS';
  const noReg = localStorage.getItem('bapas_cs_register') || '-';
  const kontak = localStorage.getItem('bapas_cs_kontak') || noReg;
  const rawDetail = localStorage.getItem('bapas_cs_detail');
  let detailKlien = null;
  if (rawDetail) {
    try { detailKlien = JSON.parse(rawDetail); } catch (_) {}
  }

  let topikTitle = '';
  let botAnswer = '';

  switch (topikKey) {
    case 'lupa_sandi':
      topikTitle = 'Lupa Sandi Login Klien';
      botAnswer = `🔑 PANDUAN PEMULIHAN KATA SANDI PORTAL KLIEN:\n\n1. Pemulihan Mandiri:\nKunjungi halaman Lupa Sandi di Portal Klien (https://bapas1medan.com/client/lupa-sandi). Masukkan No. Register (${noReg}) atau Username Anda, lalu ikuti instruksi reset sandi.\n\n2. Bantuan Reset oleh Petugas CS:\nJika Anda mengalami kendala saat reset mandiri, Petugas Administrator kami di panel Customer Service dapat mereset kata sandi Anda ke sandi default bimbingan.\n\nNotifikasi kebutuhan reset sandi Anda telah disampaikan ke petugas kami. Petugas akan segera membalas percakapan Anda di sini.`;
      break;

    case 'kendala_kamera':
      topikTitle = 'Kendala Kamera / Presensi Foto Wajib Lapor';
      botAnswer = `📷 PANDUAN MENGATASI KENDALA KAMERA WAJIB LAPOR:\n\n1. Izin Kamera Browser:\nPastikan izin akses kamera pada browser (Chrome / Safari) telah diizinkan ('Allow'). Jika diblokir, ketuk ikon gembok pada URL bar > Izin Situs > Kamera > Izinkan.\n\n2. Ketentuan Bukti Foto:\nDemi integritas dan keabsahan pelaporan bimbingan, sistem BAPAS Kelas I Medan mewajibkan pengambilan foto langsung melalui kamera (fitur unggah galeri dinonaktifkan). Pastikan wajah terlihat jelas dan pencahayaan memadai.\n\n3. Jika Kamera Tidak Terbuka:\nTutup tab lain atau aplikasi yang sedang menggunakan kamera, lalu muat ulang halaman. Petugas kami siap membantu jika kendala berlanjut.`;
      break;

    case 'jadwal_lapor':
      topikTitle = 'Jadwal & Periode Wajib Lapor Bulan Ini';
      botAnswer = `📅 INFORMASI JADWAL WAJIB LAPOR KLIEN:\n\n1. Periode Pembukaan Layanan:\nLayanan Wajib Lapor Online dibuka setiap bulan sesuai rentang tanggal pengumuman resmi yang tertera pada Beranda (https://bapas1medan.com/).\n\n2. Ketentuan Pelaporan:\nKlien Binaan aktif wajib melapor 1 (satu) kali setiap bulan bimbingan yang sedang berjalan.\n\n3. Syarat Pelaporan:\nPastikan Anda telah melengkapi Profil Klien (alamat domisili, nomor HP aktif, masa wajib lapor, dan foto profil terbaru) sebelum mengisi formulir wajib lapor.`;
      break;

    case 'litmas_integrasi':
      topikTitle = 'Layanan Litmas & Integrasi (PB/CB/CMB)';
      botAnswer = `⚖️ INFORMASI LAYANAN LITMAS & PROGRAM INTEGRASI:\n\n1. Pelayanan GRATIS (Rp 0 / Nol Pungli):\nSeluruh pelayanan bimbingan kemasyarakatan, pembuatan Litmas (Penelitian Kemasyarakatan), serta program Pembebasan Bersyarat (PB), Cuti Bersyarat (CB), Cuti Menjelang Bebas (CMB), dan Asimilasi di BAPAS Kelas I Medan adalah GRATIS tanpa dipungut biaya apapun.\n\n2. Konsultasi Berkas & Pembimbing Kemasyarakatan (PK):\nUntuk menanyakan perkembangan berkas integrasi atau nama PK pembimbing Anda, silakan ketik pertanyaan spesifik Anda di kolom pesan di bawah.`;
      break;

    case 'chat_petugas':
      topikTitle = 'Hubungi Petugas CS Langsung';
      botAnswer = `💬 LAYANAN PERCAKAPAN LANGSUNG DENGAN PETUGAS:\n\nPesan konsultasi Anda telah diteruskan ke Petugas Customer Service BAPAS Kelas I Medan yang sedang bertugas.\nSilakan ketikkan pertanyaan atau kendala bimbingan Anda secara lengkap pada kolom chat di bawah. Petugas kami akan segera merespons percakapan Anda.`;
      break;

    default:
      topikTitle = topikKey;
      botAnswer = 'Pertanyaan Anda telah kami terima dan diteruskan ke Petugas Customer Service BAPAS Medan.';
  }

  // 1. Kirim pesan pertanyaan pengguna ke log chat
  try {
    await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama,
        kontak: kontak,
        pesan: `[KATALOG BANTUAN] Saya memerlukan bantuan mengenai: ${topikTitle}`,
        is_verified: true,
        detail_klien: detailKlien,
        tipe_pesan: 'katalog_inquiry'
      })
    });
  } catch (err) {
    console.warn('Gagal mengirim permintaan topik katalog:', err);
  }

  // 2. Kirim respon resmi bot
  try {
    await fetch('/api/pusat-bantuan/bot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        pesan: botAnswer,
        topik: topikKey,
        detail_klien: detailKlien
      })
    });
  } catch (err) {
    console.warn('Gagal mengirim jawaban bot katalog:', err);
  }

  // Segarkan pesan percakapan dan paksa scroll ke pesan terbaru
  loadChatMessages(true);
}

function bukaPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    initCsViewState();
    
    // Langsung mulai polling obrolan Customer Service jika sudah ada identitas
    const nama = localStorage.getItem('bapas_cs_nama');
    if (nama) {
      startChatPolling();
    }
  }
}

function tutupPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
  stopChatPolling();
}

function switchKategoriBantuan(kat) {
  initCsViewState();
  const nama = localStorage.getItem('bapas_cs_nama');
  if (nama) {
    startChatPolling();
  }
}

async function loadChatMessages(forceScroll = false) {
  const sId = getBapasSessionId();
  try {
    const res = await fetch('/api/pusat-bantuan/pesan/' + sId);
    if (!res.ok) return;
    const data = await res.json();
    if (data.success && Array.isArray(data.data)) {
      const currentSession = localStorage.getItem('bapas_cs_session');
      // Jika sebelumnya ada percakapan aktif dan sekarang pesan kosong (karena admin mengakhiri & menghapus permanen chat)
      if (currentSession && data.data.length === 0 && lastRenderedChatJson && lastRenderedChatJson !== '[]') {
        stopChatPolling();
        alert('Sesi percakapan telah diselesaikan oleh Petugas Customer Service BAPAS Medan dan seluruh riwayat pesan telah dibersihkan secara permanen.');
        mulaiObrolanBaruCS();
        return;
      }

      // Buat signature stabil dari seluruh pesan agar urutan key JSON server tidak memicu re-render palsu
      const currentJson = data.data.map(m => `${m.id || ''}:${m.created_at || ''}:${m.status || ''}:${(m.pesan || '').length}`).join('|');
      if (currentJson !== lastRenderedChatJson || forceScroll) {
        lastRenderedChatJson = currentJson;
        renderChatStream(data.data, forceScroll);
      }
    }
  } catch (err) {
    console.warn('Gagal memuat pesan chat bantuan:', err);
  }
}

function renderChatStream(messages, forceScroll = false) {
  const box = document.getElementById('chatStreamBox');
  if (!box) return;

  // Catat posisi scroll sebelum innerHTML diganti untuk mencegah scroll melompat saat user membaca di atas
  const prevScrollTop = box.scrollTop;
  const isNearBottom = (box.scrollHeight - box.scrollTop - box.clientHeight) < 80;
  const isFirstRender = !box.dataset.hasRendered;

  const currentCsNama = (localStorage.getItem('bapas_cs_nama') || '').trim().toLowerCase();
  const currentCsRegister = (localStorage.getItem('bapas_cs_register') || '').trim();

  let html = `
    <div class="chat-msg chat-msg-bot">
      <div class="chat-avatar"><i class="fas fa-robot"></i></div>
      <div class="chat-bubble">
        <div class="chat-sender-name"><i class="fas fa-robot"></i> Asisten Layanan BAPAS:</div>
        <p class="chat-text">Halo! Selamat datang di Customer Service Resmi BAPAS Kelas I Medan. Silakan tuliskan kendala login, pertanyaan wajib lapor, atau permohonan informasi Anda di bawah ini. Petugas kami siap merespons secara real-time.</p>
        <span class="chat-time">Respon Otomatis</span>
      </div>
    </div>
  `;

  const isSessionEnded = messages.some(m => m.tipe_pesan === 'session_ended' || m.status === 'selesai');
  const inputPesan = document.getElementById('csInputPesan');
  const btnKirim = document.getElementById('btnKirimCS');
  const btnAkhiri = document.getElementById('btnAkhiriCS');

  if (isSessionEnded) {
    cancelReplyCS();
    if (inputPesan) {
      inputPesan.disabled = true;
      inputPesan.placeholder = 'Percakapan telah diakhiri. Tidak dapat mengirim pesan lagi.';
      inputPesan.style.backgroundColor = '#f1f5f9';
      inputPesan.style.cursor = 'not-allowed';
    }
    if (btnKirim) {
      btnKirim.disabled = true;
      btnKirim.style.opacity = '0.5';
      btnKirim.style.cursor = 'not-allowed';
    }
    if (btnAkhiri) {
      btnAkhiri.style.display = 'none';
    }
  } else {
    if (inputPesan) {
      inputPesan.disabled = false;
      inputPesan.placeholder = 'Tuliskan pesan Anda di sini (Tekan Enter untuk mengirim)...';
      inputPesan.style.backgroundColor = '#fff';
      inputPesan.style.cursor = 'text';
    }
    if (btnKirim) {
      btnKirim.disabled = false;
      btnKirim.style.opacity = '1';
      btnKirim.style.cursor = 'pointer';
    }
    if (btnAkhiri) {
      btnAkhiri.style.display = 'inline-flex';
    }
  }

  messages.forEach(m => {
    // 1. Session Ended Message
    if (m.tipe_pesan === 'session_ended') {
      html += `
        <div class="chat-system-ended-banner">
          <i class="fas fa-flag-checkered" style="color:#10b981;"></i>
          <span>${escapeHtml(m.pesan)}</span>
        </div>
      `;
      return;
    }

    // 2. Interactive Welcome Catalog Card
    if (m.tipe_pesan === 'katalog_welcome') {
      const timeFormatted = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit', timeZone: 'Asia/Jakarta' }) : '';
      html += `
        <div class="chat-msg chat-msg-bot chat-msg-katalog">
          <div class="chat-avatar" style="background:linear-gradient(135deg, #003580 0%, #001938 100%);"><i class="fas fa-robot"></i></div>
          <div class="chat-bubble chat-bubble-katalog">
            <div class="chat-sender-name"><i class="fas fa-robot"></i> Asisten Virtual BAPAS Kelas I Medan:</div>
            <p class="chat-text" style="color:#0f172a; margin-bottom:10px;">${escapeHtml(m.pesan)}</p>
            <div class="katalog-options-grid">
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('lupa_sandi')">
                <div class="katalog-opt-icon icon-key"><i class="fas fa-key"></i></div>
                <div class="katalog-opt-text">
                  <strong>1. Lupa Sandi Login Klien</strong>
                  <small>Panduan reset kata sandi mandiri atau bantuan reset oleh petugas CS</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('kendala_kamera')">
                <div class="katalog-opt-icon icon-camera"><i class="fas fa-camera"></i></div>
                <div class="katalog-opt-text">
                  <strong>2. Kendala Kamera / Presensi Foto</strong>
                  <small>Solusi izin kamera browser dan panduan pengambilan foto bukti lapor</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('jadwal_lapor')">
                <div class="katalog-opt-icon icon-calendar"><i class="fas fa-calendar-alt"></i></div>
                <div class="katalog-opt-text">
                  <strong>3. Jadwal &amp; Periode Wajib Lapor</strong>
                  <small>Rentang tanggal buka layanan lapor online dan ketentuan lapor bulanan</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('litmas_integrasi')">
                <div class="katalog-opt-icon icon-litmas"><i class="fas fa-balance-scale"></i></div>
                <div class="katalog-opt-text">
                  <strong>4. Layanan Litmas &amp; Integrasi (PB/CB/CMB)</strong>
                  <small>Informasi pengurusan bimbingan dan layanan integrasi 100% GRATIS</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
              </button>
              <button type="button" class="katalog-opt-btn" onclick="pilihTopikKatalog('chat_petugas')">
                <div class="katalog-opt-icon icon-headset"><i class="fas fa-headset"></i></div>
                <div class="katalog-opt-text">
                  <strong>5. Hubungi Petugas CS Langsung</strong>
                  <small>Konsultasi langsung dengan petugas Customer Service BAPAS Medan</small>
                </div>
                <i class="fas fa-chevron-right opt-arrow"></i>
