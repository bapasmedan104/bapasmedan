<!-- ==============================================
     LOGIKA REAL-TIME SCRIPT PUSAT BANTUAN
     ============================================== -->
<script>
let bapasChatPollTimer = null;
let lastRenderedChatJson = '';
let verifiedClientData = null;

function getBapasSessionId() {
  let sId = localStorage.getItem('bapas_cs_session');
  if (!sId) {
    sId = 'cs_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8);
    localStorage.setItem('bapas_cs_session', sId);
  }
  return sId;
}

function initCsViewState() {
  // Jika sedang login sebagai klien binaan di portal, otomatis gunakan identitas klien
  <% if (isLoggedIn && user && (user.no_register || userType === 'client')) { %>
    const loggedInReg = '<%= user.no_register || "" %>';
    const loggedInName = '<%= user.nama_lengkap || user.username || "Klien BAPAS" %>';
    const loggedInPhone = '<%= user.no_telepon || "-" %>';
    if (!localStorage.getItem('bapas_cs_nama') && loggedInReg) {
      localStorage.setItem('bapas_cs_type', 'registered');
      localStorage.setItem('bapas_cs_nama', loggedInName);
      localStorage.setItem('bapas_cs_register', loggedInReg);
      localStorage.setItem('bapas_cs_kontak', loggedInPhone);
    }
  <% } %>

  const csNama = localStorage.getItem('bapas_cs_nama');
  const csType = localStorage.getItem('bapas_cs_type');
  const csRegister = localStorage.getItem('bapas_cs_register');

  const prechatContainer = document.getElementById('csPrechatContainer');
  const activeChatContainer = document.getElementById('csChatActiveContainer');
  const identityPill = document.getElementById('csIdentityPill');
  const btnReset = document.getElementById('btnGantiIdentitasCS');

  if (csNama && (csType === 'guest' || (csType === 'registered' && csRegister))) {
    // Sesi sudah memiliki identitas, buka percakapan aktif
    if (prechatContainer) prechatContainer.style.display = 'none';
    if (activeChatContainer) activeChatContainer.style.display = 'flex';
    if (identityPill) {
      identityPill.style.display = 'inline-flex';
      if (csType === 'registered') {
        identityPill.innerHTML = `<i class="fas fa-check-circle" style="color:#10b981;"></i> <span>${escapeHtml(csRegister)} (${escapeHtml(csNama)})</span>`;
        identityPill.className = 'cs-identity-pill pill-registered';
      } else {
        identityPill.innerHTML = `<i class="fas fa-user"></i> <span>${escapeHtml(csNama)}</span>`;
        identityPill.className = 'cs-identity-pill pill-guest';
      }
    }
    if (btnReset) btnReset.style.display = 'inline-flex';
  } else {
    // Tampilkan layar pre-chat selection
    if (prechatContainer) prechatContainer.style.display = 'flex';
    if (activeChatContainer) activeChatContainer.style.display = 'none';
    if (identityPill) identityPill.style.display = 'none';
    if (btnReset) btnReset.style.display = 'none';
  }
}

function selectCsOption(type) {
  const cardReg = document.getElementById('cardOptRegister');
  const cardGuest = document.getElementById('cardOptGuest');
  const panelReg = document.getElementById('panelFormRegister');
  const panelGuest = document.getElementById('panelFormGuest');

  if (type === 'registered') {
    if (cardReg) cardReg.classList.add('active');
    if (cardGuest) cardGuest.classList.remove('active');
    if (panelReg) panelReg.style.display = 'block';
    if (panelGuest) panelGuest.style.display = 'none';
    const inputReg = document.getElementById('inputCsNoRegister');
    if (inputReg) setTimeout(() => inputReg.focus(), 100);
  } else {
    if (cardGuest) cardGuest.classList.add('active');
    if (cardReg) cardReg.classList.remove('active');
    if (panelGuest) panelGuest.style.display = 'block';
    if (panelReg) panelReg.style.display = 'none';
    const inputGuest = document.getElementById('inputCsNamaGuest');
    if (inputGuest) setTimeout(() => inputGuest.focus(), 100);
  }
}

async function verifikasiNoRegister() {
  const input = document.getElementById('inputCsNoRegister');
  const val = (input ? input.value : '').trim();
  const alertErr = document.getElementById('alertRegisterError');
  const previewBox = document.getElementById('previewRegisterSuccess');
  const previewDetails = document.getElementById('previewRegisterDetails');
  const btn = document.getElementById('btnCekRegister');

  if (alertErr) {
    alertErr.style.display = 'none';
    alertErr.innerHTML = '';
  }
  if (previewBox) previewBox.style.display = 'none';

  if (!val) {
    if (alertErr) {
      alertErr.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Harap masukkan nomor registrasi klien Anda (contoh: REG-2026).';
      alertErr.style.display = 'flex';
    }
    if (input) input.focus();
    return;
  }

  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Memeriksa...</span>';
  }

  try {
    const res = await fetch('/api/pusat-bantuan/cek-registrasi', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ no_register: val })
    });
    const data = await res.json();
    if (!data.success) {
      if (alertErr) {
        alertErr.innerHTML = `<i class="fas fa-times-circle"></i> <span>${escapeHtml(data.message || 'Gagal memeriksa nomor register.')}</span>`;
        alertErr.style.display = 'flex';
      }
    } else if (!data.found) {
      if (alertErr) {
        alertErr.innerHTML = `
          <i class="fas fa-times-circle" style="font-size:18px; margin-top:2px;"></i>
          <div>
            <strong>Nomor Register Tidak Ditemukan</strong><br>
            ${escapeHtml(data.message)}<br>
            <small style="display:inline-block; margin-top:5px; color:#b91c1c;">
              Jika Anda adalah pengunjung atau masyarakat umum, silakan pilih kartu <strong>Belum Punya Nomor Registrasi</strong> di atas.
            </small>
          </div>
        `;
        alertErr.style.display = 'flex';
      }
    } else {
      // Data klien ditemukan
      verifiedClientData = data.client;
      if (previewDetails) {
        previewDetails.innerHTML = `
          <table class="preview-details-table">
            <tr><th>No. Registrasi:</th><td style="color:#003580; font-weight:800; font-size:14px;">${escapeHtml(data.client.no_register)}</td></tr>
            <tr><th>Nama Lengkap:</th><td style="font-weight:700;">${escapeHtml(data.client.nama_lengkap)}</td></tr>
            <tr><th>Status Binaan:</th><td><span class="badge-status-aktif">${escapeHtml(data.client.status)}</span></td></tr>
            <tr><th>Masa Wajib Lapor:</th><td style="color:#b45309; font-weight:700;">${escapeHtml(data.client.masa_wajib_lapor)}</td></tr>
            <tr><th>Kontak / Telp:</th><td>${escapeHtml(data.client.no_telepon)}</td></tr>
            <tr><th>Alamat Domisili:</th><td>${escapeHtml(data.client.alamat)}</td></tr>
          </table>
          <div style="margin-top:10px; font-size:12px; color:#15803d; font-style:italic;">
            <i class="fas fa-shield-alt"></i> Data ini akan otomatis disampaikan ke ruang percakapan Customer Service BAPAS Medan.
          </div>
        `;
      }
      if (previewBox) previewBox.style.display = 'block';
    }
  } catch (err) {
    if (alertErr) {
      alertErr.innerHTML = `<i class="fas fa-exclamation-triangle"></i> Terjadi kesalahan jaringan saat memverifikasi: ${escapeHtml(err.message)}`;
      alertErr.style.display = 'flex';
    }
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-search"></i> <span>Periksa Data</span>';
    }
  }
}

async function mulaiChatTerverifikasi() {
  if (!verifiedClientData) {
    alert('Silakan lakukan pemeriksaan nomor registrasi terlebih dahulu.');
    return;
  }

  const sId = getBapasSessionId();
  const client = verifiedClientData;

  localStorage.setItem('bapas_cs_type', 'registered');
  localStorage.setItem('bapas_cs_nama', client.nama_lengkap);
  localStorage.setItem('bapas_cs_register', client.no_register);
  localStorage.setItem('bapas_cs_kontak', client.no_telepon || client.no_register);
  localStorage.setItem('bapas_cs_detail', JSON.stringify(client));

  // Tampilkan layar chat aktif
  initCsViewState();

  // Kirimkan kartu verifikasi data registrasi klien ke log percakapan
  try {
    await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: client.nama_lengkap,
        kontak: client.no_telepon || client.no_register,
        pesan: `[KLIEN TERVERIFIKASI RESMI] Halo Customer Service BAPAS Medan, data bimbingan saya dengan No. Register ${client.no_register} telah terverifikasi resmi oleh sistem.`,
        is_verified: true,
        tipe_pesan: 'client_card',
        detail_klien: client
      })
    });
  } catch (e) {
    console.warn('Gagal memposting data verifikasi awal:', e);
  }

  startChatPolling();
}

function mulaiChatPengunjung() {
  const inputNama = document.getElementById('inputCsNamaGuest');
  const inputKontak = document.getElementById('inputCsKontakGuest');
  const alertErr = document.getElementById('alertGuestError');

  if (alertErr) alertErr.style.display = 'none';

  const nama = (inputNama ? inputNama.value : '').trim();
  const kontak = (inputKontak ? inputKontak.value : '').trim();

  if (!nama) {
    if (alertErr) {
      alertErr.innerHTML = '<i class="fas fa-exclamation-circle"></i> Harap masukkan Nama Lengkap Anda terlebih dahulu.';
      alertErr.style.display = 'flex';
    }
    if (inputNama) inputNama.focus();
    return;
  }

  localStorage.setItem('bapas_cs_type', 'guest');
  localStorage.setItem('bapas_cs_nama', nama);
  localStorage.setItem('bapas_cs_kontak', kontak || '-');
  localStorage.removeItem('bapas_cs_register');
  localStorage.removeItem('bapas_cs_detail');

  initCsViewState();
  startChatPolling();
}

function resetCsSession() {
  if (confirm('Apakah Anda ingin mengganti identitas / nomor registrasi obrolan Customer Service?')) {
    localStorage.removeItem('bapas_cs_type');
    localStorage.removeItem('bapas_cs_nama');
    localStorage.removeItem('bapas_cs_register');
    localStorage.removeItem('bapas_cs_kontak');
    localStorage.removeItem('bapas_cs_detail');
    localStorage.removeItem('bapas_cs_session'); // Buat sesi baru
    stopChatPolling();
    lastRenderedChatJson = '';
    verifiedClientData = null;
    initCsViewState();
  }
}

function bukaPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    initCsViewState();
    
    // Jika tab CS sedang aktif dan identitas sudah dipilih, mulai polling chat
    if (document.getElementById('kategoriCS').classList.contains('active')) {
      const nama = localStorage.getItem('bapas_cs_nama');
      if (nama) {
        startChatPolling();
      }
    }
  }
}

function tutupPusatBantuan() {
  const modal = document.getElementById('modalPusatBantuan');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
  stopChatPolling();
}

function switchKategoriBantuan(kat) {
  const btnLangkah = document.getElementById('tabHeadLangkah');
  const btnCS = document.getElementById('tabHeadCS');
  const paneLangkah = document.getElementById('kategoriLangkah');
  const paneCS = document.getElementById('kategoriCS');

  if (kat === 'langkah') {
    btnLangkah.classList.add('active');
    btnCS.classList.remove('active');
    paneLangkah.classList.add('active');
    paneCS.classList.remove('active');
    stopChatPolling();
  } else {
    btnCS.classList.add('active');
    btnLangkah.classList.remove('active');
    paneCS.classList.add('active');
    paneLangkah.classList.remove('active');
    initCsViewState();
    const nama = localStorage.getItem('bapas_cs_nama');
    if (nama) {
      startChatPolling();
    }
  }
}

async function loadChatMessages() {
  const sId = getBapasSessionId();
  try {
    const res = await fetch('/api/pusat-bantuan/pesan/' + sId);
    if (!res.ok) return;
    const data = await res.json();
    if (data.success && Array.isArray(data.data)) {
      const currentJson = JSON.stringify(data.data);
      if (currentJson !== lastRenderedChatJson) {
        lastRenderedChatJson = currentJson;
        renderChatStream(data.data);
      }
    }
  } catch (err) {
    console.warn('Gagal memuat pesan chat bantuan:', err);
  }
}

function renderChatStream(messages) {
  const box = document.getElementById('chatStreamBox');
  if (!box) return;

  let html = `
    <div class="chat-msg chat-msg-bot">
      <div class="chat-avatar"><i class="fas fa-user-shield"></i></div>
      <div class="chat-bubble">
        <div class="chat-sender-name">Asisten Layanan BAPAS:</div>
        <p class="chat-text">Halo! Selamat datang di Customer Service Resmi BAPAS Kelas I Medan. Silakan tuliskan kendala login, pertanyaan wajib lapor, atau permohonan informasi Anda di bawah ini. Petugas kami siap merespons secara real-time.</p>
        <span class="chat-time">Respon Otomatis</span>
      </div>
    </div>
  `;

  messages.forEach(m => {
    const isUser = m.pengirim === 'user';
    const isBot = m.pengirim === 'bot';
    const timeFormatted = m.created_at ? new Date(m.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' }) : '';

    if (isUser) {
      let contentHtml = '';
      if (m.tipe_pesan === 'client_card' && m.detail_klien) {
        contentHtml = renderVerifiedClientCardHtml(m.detail_klien, m.pesan);
      } else {
        contentHtml = `<p class="chat-text">${escapeHtml(m.pesan)}</p>`;
      }

      html += `
        <div class="chat-msg chat-msg-user">
          <div class="chat-bubble">
            <div class="chat-sender-name-user">
              <i class="fas ${m.is_verified ? 'fa-id-badge' : 'fa-user-circle'}"></i> 
              <span>${escapeHtml(m.nama || 'Anda')}</span>
              ${m.is_verified ? '<span class="bubble-tag-verified"><i class="fas fa-check-circle"></i> Terverifikasi</span>' : ''}
            </div>
            ${contentHtml}
            <span class="chat-time">${timeFormatted} &bull; Terkirim</span>
          </div>
        </div>
      `;
    } else {
      const senderTitle = isBot ? 'Asisten Virtual BAPAS' : (m.admin_name || 'Petugas CS BAPAS');
      html += `
        <div class="chat-msg ${isBot ? 'chat-msg-bot' : 'chat-msg-admin'}">
          <div class="chat-avatar" style="${isBot ? '' : 'background:#16a34a;'}">
            <i class="fas ${isBot ? 'fa-robot' : 'fa-headset'}"></i>
          </div>
          <div class="chat-bubble">
            <div class="chat-sender-name">${escapeHtml(senderTitle)}:</div>
            <p class="chat-text">${escapeHtml(m.pesan)}</p>
            <span class="chat-time">${timeFormatted}</span>
          </div>
        </div>
      `;
    }
  });

  box.innerHTML = html;
  box.scrollTop = box.scrollHeight;
}

function renderVerifiedClientCardHtml(client, messageText) {
  return `
    <div class="verified-card-bubble">
      <div class="card-bubble-header">
        <div style="display:flex; align-items:center; gap:6px;">
          <i class="fas fa-shield-alt text-success" style="color:#16a34a;"></i>
          <strong>DATA KLIEN BINAAN TERVERIFIKASI</strong>
        </div>
        <span class="badge-bubble-reg">RESMI BAPAS</span>
      </div>
      <table class="card-bubble-table">
        <tr><th>No. Register:</th><td class="text-highlight">${escapeHtml(client.no_register || '-')}</td></tr>
        <tr><th>Nama Lengkap:</th><td style="font-weight:700;">${escapeHtml(client.nama_lengkap || '-')}</td></tr>
        <tr><th>Status Binaan:</th><td><span class="status-pill">${escapeHtml(client.status || 'aktif')}</span></td></tr>
        <tr><th>Masa Lapor:</th><td style="color:#b45309; font-weight:700;">${escapeHtml(client.masa_wajib_lapor || '-')}</td></tr>
        <tr><th>No. Telepon:</th><td>${escapeHtml(client.no_telepon || '-')}</td></tr>
        <tr><th>Alamat:</th><td>${escapeHtml(client.alamat || '-')}</td></tr>
      </table>
      <div class="card-bubble-note">
        <i class="fas fa-check-circle" style="color:#16a34a;"></i>
        <span>${escapeHtml(messageText || 'Data registrasi terdeteksi langsung dari database BAPAS Kelas I Medan.')}</span>
      </div>
    </div>
  `;
}

function startChatPolling() {
  loadChatMessages();
  if (!bapasChatPollTimer) {
    // Polling setiap 3 detik agar pesan respon dari admin tampil secara real-time
    bapasChatPollTimer = setInterval(loadChatMessages, 3000);
  }
}

function stopChatPolling() {
  if (bapasChatPollTimer) {
    clearInterval(bapasChatPollTimer);
    bapasChatPollTimer = null;
  }
}

async function handleKirimPesanCS(e) {
  e.preventDefault();
  const inputPesan = document.getElementById('csInputPesan');
  const btnKirim = document.getElementById('btnKirimCS');

  const pesan = (inputPesan.value || '').trim();
  const nama = localStorage.getItem('bapas_cs_nama') || 'Pengunjung';
  const kontak = localStorage.getItem('bapas_cs_kontak') || localStorage.getItem('bapas_cs_register') || '-';
  const csType = localStorage.getItem('bapas_cs_type');
  const isVerified = csType === 'registered';
  const rawDetail = localStorage.getItem('bapas_cs_detail');
  let detailKlien = null;
  if (rawDetail) {
    try { detailKlien = JSON.parse(rawDetail); } catch (_) {}
  }
  const sId = getBapasSessionId();

  if (!pesan) return;

  btnKirim.disabled = true;
  btnKirim.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  try {
    const res = await fetch('/api/pusat-bantuan/kirim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        session_id: sId,
        nama: nama,
        kontak: kontak,
        pesan: pesan,
        is_verified: isVerified,
        detail_klien: detailKlien,
        tipe_pesan: 'text'
      })
    });
    const result = await res.json();
    if (result.success) {
      inputPesan.value = '';
      loadChatMessages();
    } else {
      alert(result.message || 'Gagal mengirim pesan bantuan.');
    }
  } catch (err) {
    alert('Terjadi kendala jaringan saat mengirim pesan: ' + err.message);
  } finally {
    btnKirim.disabled = false;
    btnKirim.innerHTML = '<i class="fas fa-paper-plane"></i> <span class="btn-send-label">Kirim</span>';
    inputPesan.focus();
  }
}

function escapeHtml(text) {
  if (!text) return '';
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
</script>