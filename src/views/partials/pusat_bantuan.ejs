            </div>
            <span class="chat-time">${timeFormatted} &bull; Katalog Bantuan Interaktif</span>
          </div>
        </div>
      `;
      return;
    }

    const isBot = m.pengirim === 'bot' || m.nama === 'Asisten Layanan BAPAS';
    let isUser = false;
    if (!isBot) {
      if (m.pengirim === 'user' || m.tipe_pesan === 'client_card') {
        isUser = true;
      } else if (currentCsNama && m.nama && m.nama.trim().toLowerCase() === currentCsNama) {
