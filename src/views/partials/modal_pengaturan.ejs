<!-- Translation Widget Init Script -->
<script type="text/javascript">
function googleTranslateElementInit() {
  if (window.google && window.google.translate) {
    new window.google.translate.TranslateElement({
      pageLanguage: 'id',
      includedLanguages: 'id,en,ms,ar,zh-CN,ja,fr,de,ko,es,nl,ru,th,vi,hi',
      layout: window.google.translate.TranslateElement.InlineLayout.SIMPLE,
      autoDisplay: false
    }, 'google_translate_element');
  }
}
</script>
<script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>

<script>
(function() {
  const STORAGE_LANG_KEY = 'bapas_site_lang';
  const STORAGE_REFRESH_KEY = 'bapas_public_refresh_mode';

  let pubRefreshTimer = null;
  let pubCountdownTimer = null;
  let pubRemainingSeconds = 1;
  let isPubUpdating = false;

  // FUNGSI NETRALISIR BANNER & PERGESERAN LAYOUT
  function neutralizeTranslationBanners() {
    try {
      if (document.body) {
        if (document.body.style.top && document.body.style.top !== '0px') {
          document.body.style.setProperty('top', '0px', 'important');
        }
        if (document.body.style.marginTop && document.body.style.marginTop !== '0px') {
          document.body.style.setProperty('margin-top', '0px', 'important');
        }
      }
      if (document.documentElement && document.documentElement.style.top && document.documentElement.style.top !== '0px') {
        document.documentElement.style.setProperty('top', '0px', 'important');
      }

      const elementsToHide = document.querySelectorAll(
        'body > .skiptranslate, [class*="VIpgJd"], iframe[class*="goog"], iframe[id*=":"], #goog-gt-tt, #goog-gt-vt, .goog-te-banner-frame'
      );
      elementsToHide.forEach(function(el) {
        el.style.setProperty('display', 'none', 'important');
        el.style.setProperty('visibility', 'hidden', 'important');
        el.style.setProperty('height', '0px', 'important');
        el.style.setProperty('width', '0px', 'important');
        el.style.setProperty('opacity', '0', 'important');
        el.style.setProperty('pointer-events', 'none', 'important');
      });
    } catch (e) {}
  }

  // Observer agar banner langsung hilang seketika saat diinjeksikan
  try {
    const bannerObserver = new MutationObserver(neutralizeTranslationBanners);
    if (document.documentElement) {
      bannerObserver.observe(document.documentElement, {
        attributes: true,
        childList: true,
        subtree: true,
        attributeFilter: ['style', 'class']
      });
    }
  } catch (e) {}

  setInterval(neutralizeTranslationBanners, 150);
  window.addEventListener('load', neutralizeTranslationBanners);

  // 1. OPEN / CLOSE MODAL
  window.bukaModalPengaturan = function() {
    const modal = document.getElementById('modalPengaturanSitus');
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      syncModalUiState();
    }
  };

  window.tutupModalPengaturan = function() {
    const modal = document.getElementById('modalPengaturanSitus');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.tutupModalPengaturan();
    }
  });

  // 2. TRANSLATION LOGIC
  window.applyGoogleLanguage = function(langCode, btnEl) {
    if (!langCode) return;
    localStorage.setItem(STORAGE_LANG_KEY, langCode);

    // Update active class on chips
    document.querySelectorAll('.lang-chip').forEach(c => c.classList.remove('active'));
    if (btnEl) {
      btnEl.classList.add('active');
    } else {
      const matchChip = Array.from(document.querySelectorAll('.lang-chip')).find(b => b.getAttribute('onclick') && b.getAttribute('onclick').includes(`'${langCode}'`));
      if (matchChip) matchChip.classList.add('active');
    }

    const domain = window.location.hostname;
    
    // Clear old cookies first
    document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
    document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${domain};`;
    document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.${domain};`;

    if (langCode !== 'id') {
      const cookieValue = `/id/${langCode}`;
      document.cookie = `googtrans=${cookieValue}; path=/;`;
      document.cookie = `googtrans=${cookieValue}; path=/; domain=${domain}`;
      document.cookie = `googtrans=${cookieValue}; path=/; domain=.${domain}`;
    }

    // Trigger select internal jika sudah ada
    const gSelect = document.querySelector('#google_translate_element select');
    if (gSelect) {
      gSelect.value = langCode;
      gSelect.dispatchEvent(new Event('change'));
      neutralizeTranslationBanners();
    }
    
    // Refresh halus agar translasi bersih dan banner tidak pernah muncul
    setTimeout(function() {
      window.location.reload();
    }, 150);
  };

  // 3. AUTO-REFRESH LOGIC
  function getPubStoredMode() {
    return localStorage.getItem(STORAGE_REFRESH_KEY) || '1s';
  }

  function setPubStoredMode(val) {
    localStorage.setItem(STORAGE_REFRESH_KEY, val);
  }

  function updatePubStatusDisplay(mode) {
    const pulseDot = document.getElementById('pubRefreshPulseDot');
    const statusLabel = document.getElementById('pubRefreshStatusLabel');
    const badge = document.getElementById('pubRefreshCountdownPill');

    if (mode === '1s') {
      if (pulseDot) pulseDot.className = 'refresh-pulse-dot';
      if (statusLabel) statusLabel.innerHTML = 'Mode: <span style="color:#059669;">1 Detik (Default / Real-Time)</span>';
      if (badge) badge.innerText = `${pubRemainingSeconds}s`;
    } else if (mode === '5m') {
      if (pulseDot) pulseDot.className = 'refresh-pulse-dot';
      if (statusLabel) statusLabel.innerHTML = 'Mode: <span style="color:#0284c7;">5 Menit (Santai)</span>';
      const mins = Math.floor(pubRemainingSeconds / 60);
      const secs = pubRemainingSeconds % 60;
      if (badge) badge.innerText = `${mins}m ${secs < 10 ? '0' : ''}${secs}s`;
    } else {
      if (pulseDot) pulseDot.className = 'refresh-pulse-dot paused';
      if (statusLabel) statusLabel.innerHTML = 'Mode: <span style="color:#64748b;">Manual / Jeda</span>';
      if (badge) badge.innerText = 'OFF';
    }
  }

  function updatePubLastTime() {
    const el = document.getElementById('pubRefreshLastTime');
    if (el) {
      const now = new Date();
      el.innerText = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Jakarta' }) + ' WIB';
    }
  }

  async function performPublicUpdate(isManual = false) {
    if (isPubUpdating) return;
    
    // Jangan ganggu jika user sedang membuka modal obrolan CS atau mengetik
    const csModal = document.getElementById('modalPusatBantuan');
    if (csModal && csModal.style.display === 'flex') return;
    const settingsModal = document.getElementById('modalPengaturanSitus');
    if (settingsModal && settingsModal.style.display === 'flex' && !isManual) return;

    isPubUpdating = true;
    const pulseDot = document.getElementById('pubRefreshPulseDot');
    const btnManual = document.getElementById('btnPubManualRefresh');
    if (pulseDot) pulseDot.classList.add('updating');
    if (btnManual) btnManual.classList.add('loading');

    try {
      const res = await fetch(window.location.href, {
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Cache-Control': 'no-cache' }
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const text = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(text, 'text/html');

      // 1. Update Pengumuman Jadwal Wajib Lapor di Beranda
      const curBanner = document.querySelector('.banner-pengumuman, .jadwal-box, .hero-section');
      const newBanner = doc.querySelector('.banner-pengumuman, .jadwal-box, .hero-section');
      if (curBanner && newBanner && curBanner.innerHTML !== newBanner.innerHTML) {
        curBanner.innerHTML = newBanner.innerHTML;
      }

      // 2. Update Berita Terbaru di Beranda / Halaman Berita
      const curNews = document.querySelector('.news-grid, .berita-grid, .grid-berita');
      const newNews = doc.querySelector('.news-grid, .berita-grid, .grid-berita');
      if (curNews && newNews && curNews.innerHTML !== newNews.innerHTML) {
        curNews.innerHTML = newNews.innerHTML;
      }

      updatePubLastTime();
    } catch (err) {
      console.warn('Public background update:', err.message);
    } finally {
      isPubUpdating = false;
      if (pulseDot) pulseDot.classList.remove('updating');
      if (btnManual) btnManual.classList.remove('loading');
      updatePubStatusDisplay(getPubStoredMode());
    }
  }

  function startPubTimers() {
    if (pubRefreshTimer) clearInterval(pubRefreshTimer);
    if (pubCountdownTimer) clearInterval(pubCountdownTimer);

    const mode = getPubStoredMode();
    if (mode === 'manual') {
      pubRemainingSeconds = 0;
      updatePubStatusDisplay('manual');
      return;
    }

    const intervalSeconds = mode === '1s' ? 1 : 300;
    pubRemainingSeconds = intervalSeconds;
    updatePubStatusDisplay(mode);

    pubCountdownTimer = setInterval(() => {
      if (mode === '1s') {
        pubRemainingSeconds = 1;
        updatePubStatusDisplay('1s');
      } else {
        pubRemainingSeconds--;
        if (pubRemainingSeconds <= 0) {
          pubRemainingSeconds = intervalSeconds;
        }
        updatePubStatusDisplay('5m');
      }
    }, 1000);

    pubRefreshTimer = setInterval(() => {
      performPublicUpdate(false);
    }, intervalSeconds * 1000);
  }

  window.changePublicRefreshMode = function(val) {
    setPubStoredMode(val);
    syncRadioActiveCards(val);
    startPubTimers();
  };

  function syncRadioActiveCards(val) {
    document.querySelectorAll('.refresh-radio-card').forEach(c => c.classList.remove('active'));
    if (val === '1s') {
      const el = document.getElementById('labelRadio1s');
      if (el) el.classList.add('active');
    } else if (val === '5m') {
      const el = document.getElementById('labelRadio5m');
      if (el) el.classList.add('active');
    } else {
      const el = document.getElementById('labelRadioManual');
      if (el) el.classList.add('active');
    }
  }

  window.triggerPublicManualRefresh = function() {
    performPublicUpdate(true);
  };

  function syncModalUiState() {
    const curLang = localStorage.getItem(STORAGE_LANG_KEY) || 'id';
    document.querySelectorAll('.lang-chip').forEach(c => c.classList.remove('active'));
    const matchChip = Array.from(document.querySelectorAll('.lang-chip')).find(b => b.getAttribute('onclick').includes(`'${curLang}'`));
    if (matchChip) matchChip.classList.add('active');

    const curMode = getPubStoredMode();
    const radio = document.querySelector(`input[name="publicRefreshRadio"][value="${curMode}"]`);
    if (radio) radio.checked = true;
    syncRadioActiveCards(curMode);
    updatePubLastTime();
    updatePubStatusDisplay(curMode);
  }

  document.addEventListener('DOMContentLoaded', () => {
    syncModalUiState();
    startPubTimers();
  });

})();
</script>
