<!-- =======================================================
     MODAL PENGATURAN SITUS WEB RESMI BAPAS KELAS I MEDAN
     Berisi:
     1. Pilihan Bahasa (Terjemahan Otomatis Multi-Bahasa)
     2. Kontrol Refresh Halaman (1 Detik Default, 5 Menit, Manual)
     ======================================================= -->

<!-- MODAL OVERLAY -->
<div id="modalPengaturanSitus" class="settings-modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modalSettingsTitle">
  <div class="settings-modal-window">
    
    <!-- Modal Header -->
    <div class="settings-modal-header">
      <div style="display:flex; align-items:center; gap:10px;">
        <div class="settings-header-icon">
          <i class="fas fa-sliders-h"></i>
        </div>
        <div>
          <h3 id="modalSettingsTitle" class="settings-header-title">Pengaturan Situs Web</h3>
          <span class="settings-header-subtitle">Balai Pemasyarakatan (BAPAS) Kelas I Medan</span>
        </div>
      </div>
      <button type="button" class="btn-close-settings" onclick="tutupModalPengaturan()" aria-label="Tutup Pengaturan" title="Tutup">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="settings-modal-body">
      
      <!-- ==============================================
           SECTION 1: PILIHAN BAHASA (MULTI-LANGUAGE)
           ============================================== -->
      <div class="settings-section">
        <div class="settings-section-title">
          <i class="fas fa-globe text-primary"></i>
          <div>
            <strong>Pilihan Bahasa / Language</strong>
            <span class="settings-section-desc">Terjemahan otomatis multi-bahasa resmi ke bahasa pilihan Anda</span>
          </div>
        </div>

        <!-- Google Translate Widget Element (Hidden standard container) -->
        <div id="google_translate_element" style="display:none;"></div>

        <!-- Tombol Cepat Bahasa Pilihan (Flag Chips) -->
        <div class="language-chips-grid">
          <button type="button" class="lang-chip active" onclick="applyGoogleLanguage('id', this)" title="Bahasa Indonesia">
            <span class="flag-icon">🇮🇩</span>
            <span class="lang-name">Indonesia</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('en', this)" title="English (Inggris)">
            <span class="flag-icon">🇬🇧</span>
            <span class="lang-name">English</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('ms', this)" title="Bahasa Melayu">
            <span class="flag-icon">🇲🇾</span>
            <span class="lang-name">Melayu</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('ar', this)" title="العربية (Arab)">
            <span class="flag-icon">🇸🇦</span>
            <span class="lang-name">العربية</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('zh-CN', this)" title="中文 (Mandarin)">
            <span class="flag-icon">🇨🇳</span>
            <span class="lang-name">中文</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('ja', this)" title="日本語 (Jepang)">
            <span class="flag-icon">🇯🇵</span>
            <span class="lang-name">日本語</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('fr', this)" title="Français (Prancis)">
            <span class="flag-icon">🇫🇷</span>
            <span class="lang-name">Français</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('de', this)" title="Deutsch (Jerman)">
            <span class="flag-icon">🇩🇪</span>
            <span class="lang-name">Deutsch</span>
          </button>
          <button type="button" class="lang-chip" onclick="applyGoogleLanguage('ko', this)" title="한국어 (Korea)">
            <span class="flag-icon">🇰🇷</span>
            <span class="lang-name">한국어</span>
          </button>
        </div>

        <div style="margin-top:10px; display:flex; align-items:center; gap:8px;">
          <label for="selectMoreLanguages" style="font-size:12px; font-weight:700; color:#475569;">
            <i class="fas fa-language"></i> Pilihan Bahasa Lainnya:
          </label>
          <select id="selectMoreLanguages" class="settings-select" onchange="applyGoogleLanguage(this.value, null)" style="flex:1;">
            <option value="">-- Pilih Bahasa Lain --</option>
            <option value="id">Bahasa Indonesia</option>
            <option value="en">English (Inggris)</option>
            <option value="ms">Bahasa Melayu</option>
            <option value="ar">العربية (Arab)</option>
            <option value="zh-CN">中文 (Mandarin Tradisional/Sederhana)</option>
            <option value="ja">日本語 (Jepang)</option>
            <option value="ko">한국어 (Korea)</option>
            <option value="fr">Français (Prancis)</option>
            <option value="de">Deutsch (Jerman)</option>
            <option value="es">Español (Spanyol)</option>
            <option value="nl">Nederlands (Belanda)</option>
            <option value="ru">Русский (Rusia)</option>
            <option value="th">ไทย (Thailand)</option>
            <option value="vi">Tiếng Việt (Vietnam)</option>
            <option value="hi">हिन्दी (Hindi)</option>
          </select>
        </div>
      </div>

      <hr style="border:none; border-top:1px solid #e2e8f0; margin:18px 0;">

      <!-- ==============================================
           SECTION 2: REFRESH HALAMAN REAL-TIME
           ============================================== -->
      <div class="settings-section">
        <div class="settings-section-title">
          <i class="fas fa-sync-alt text-primary"></i>
          <div>
            <strong>Pembaruan Halaman (Auto-Refresh)</strong>
            <span class="settings-section-desc">Pilih interval pembaruan data informasi dan pengumuman secara otomatis</span>
          </div>
        </div>

        <!-- Status Card Refresh -->
        <div class="settings-refresh-status-box">
          <div style="display:flex; align-items:center; gap:10px;">
            <span class="refresh-pulse-dot" id="pubRefreshPulseDot"></span>
            <div>
              <div id="pubRefreshStatusLabel" style="font-size:13px; font-weight:800; color:#0f172a;">
                Mode: <span style="color:#059669;">1 Detik (Real-Time)</span>
              </div>
              <div style="font-size:11.5px; color:#64748b;">
                Pembaruan terakhir: <span id="pubRefreshLastTime" style="font-weight:700;">Memuat...</span>
              </div>
            </div>
          </div>
          <span class="refresh-countdown-pill" id="pubRefreshCountdownPill" title="Hitung mundur refresh">1s</span>
        </div>

        <!-- Mode Selector -->
        <div style="margin-top:14px; display:flex; flex-direction:column; gap:8px;">
          <label style="font-size:12.5px; font-weight:700; color:#334155;">
            Pilih Mode Refresh:
          </label>
          <div class="refresh-radio-group">
            <label class="refresh-radio-card active" id="labelRadio1s">
              <input type="radio" name="publicRefreshRadio" value="1s" checked onchange="changePublicRefreshMode(this.value)">
              <div class="radio-content">
                <div class="radio-title"><i class="fas fa-bolt" style="color:#f59e0b;"></i> 1 Detik (Default / Real-Time)</div>
                <div class="radio-sub">Data pengumuman & berita baru langsung masuk seketika tanpa delay</div>
              </div>
            </label>
            <label class="refresh-radio-card" id="labelRadio5m">
              <input type="radio" name="publicRefreshRadio" value="5m" onchange="changePublicRefreshMode(this.value)">
              <div class="radio-content">
                <div class="radio-title"><i class="fas fa-clock" style="color:#0284c7;"></i> 5 Menit (Santai)</div>
                <div class="radio-sub">Pembaruan berkala hemat kuota internet dan daya baterai</div>
              </div>
            </label>
            <label class="refresh-radio-card" id="labelRadioManual">
              <input type="radio" name="publicRefreshRadio" value="manual" onchange="changePublicRefreshMode(this.value)">
              <div class="radio-content">
                <div class="radio-title"><i class="fas fa-pause-circle" style="color:#64748b;"></i> Manual / Jeda</div>
                <div class="radio-sub">Auto-refresh dinonaktifkan, hanya update saat tombol ditekan</div>
              </div>
            </label>
          </div>
        </div>

        <!-- Tombol Refresh Manual -->
        <div style="margin-top:14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
          <button type="button" class="btn-settings-manual-sync" onclick="triggerPublicManualRefresh()" id="btnPubManualRefresh">
            <i class="fas fa-sync-alt" id="iconPubManualRefresh"></i>
            <span>Refresh Halaman Sekarang</span>
          </button>
          <span style="font-size:11.5px; color:#64748b; font-style:italic;">
            <i class="fas fa-shield-alt"></i> Tanpa layar berkedip (Seamless Fetch)
          </span>
        </div>

      </div>

    </div>

    <!-- Modal Footer -->
    <div class="settings-modal-footer">
      <span style="font-size:12px; color:#64748b;">
        <i class="fas fa-check-circle" style="color:#10b981;"></i> Pengaturan otomatis tersimpan di perangkat ini.
      </span>
      <button type="button" class="btn btn-primary" onclick="tutupModalPengaturan()" style="padding:8px 20px; font-size:13px; font-weight:700;">
        Tutup
      </button>
    </div>

  </div>
</div>

<style>
