<!-- 4 LANGKAH WAJIB LAPOR ONLINE (EQUAL HEIGHT & RAPI) -->
<section style="padding:65px 0; background:#f8fafc; border-bottom:1px solid #e2e8f0;">
  <div class="container">
    <div style="text-align:center; max-width:700px; margin:0 auto 45px;">
      <span style="color:var(--primary); font-weight:800; text-transform:uppercase; font-size:12px; letter-spacing:1.5px; display:inline-block; margin-bottom:8px;">
        Layanan Cepat & Akuntabel
      </span>
      <h2 style="font-family:'Playfair Display', serif; font-size:30px; color:#0f172a; margin-bottom:10px;">
        4 Langkah Wajib Lapor Klien Online
      </h2>
      <p style="font-size:14.5px; color:#64748b; line-height:1.6;">
        Tunaikan kewajiban lapor secara mandiri melalui smartphone atau komputer secara transparan dan mudah dipahami.
      </p>
      <div style="width:50px; height:3px; background:var(--gold); margin:14px auto 0;"></div>
    </div>

    <div class="step-grid-4">
      
      <!-- Step 1 -->
      <div class="step-card-box">
        <div class="step-badge-num" style="background:var(--primary);">1</div>
        <div class="step-icon-wrap" style="background:#eff6ff; color:var(--primary);">
          <i class="fas fa-sign-in-alt"></i>
        </div>
        <h3 class="step-title">Masuk Akun Klien</h3>
        <p class="step-desc">
          Gunakan Nomor Register Klien atau Nomor Handphone yang telah terverifikasi saat penerimaan awal di BAPAS Medan.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="step-card-box">
        <div class="step-badge-num" style="background:#16a34a;">2</div>
        <div class="step-icon-wrap" style="background:#f0fdf4; color:#16a34a;">
          <i class="fas fa-camera-retro"></i>
        </div>
        <h3 class="step-title">Ambil Foto Bukti</h3>
        <p class="step-desc">
          Ambil swafoto bukti presensi langsung menggunakan kamera ponsel/laptop Anda dengan pencahayaan yang jelas.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="step-card-box">
        <div class="step-badge-num" style="background:#d97706;">3</div>
        <div class="step-icon-wrap" style="background:#fffbeb; color:#d97706;">
          <i class="fas fa-edit"></i>
        </div>
        <h3 class="step-title">Tulis Perkembangan</h3>
        <p class="step-desc">
          Isi ringkasan kegiatan positif, pekerjaan, dan perkembangan sosial Anda selama satu bulan terakhir dengan jujur.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="step-card-box">
        <div class="step-badge-num" style="background:#2563eb;">4</div>
        <div class="step-icon-wrap" style="background:#eff6ff; color:#2563eb;">
          <i class="fas fa-user-shield"></i>
        </div>
        <h3 class="step-title">Verifikasi Petugas</h3>
        <p class="step-desc">
          Laporan diverifikasi oleh Pembimbing Kemasyarakatan (PK) dan tercatat sah dalam buku riwayat kepatuhan klien.
        </p>
      </div>

    </div>

    <div style="text-align:center; margin-top:35px;">
      <a href="/login" class="btn-hero btn-hero-primary" style="display:inline-flex; width:auto; padding:12px 30px;">
        Mulai Pelaporan Sekarang <i class="fas fa-arrow-right" style="margin-left:6px;"></i>
      </a>
    </div>
  </div>
</section>

<!-- LAYANAN UTAMA PEMASYARAKATAN (KARTU KONSISTEN) -->
