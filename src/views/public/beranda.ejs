<%- include('../partials/header') %>
<%- include('../partials/alerts') %>

<!-- HERO SECTION RESMI & MODERN -->
<section class="hero-section">
  <div style="position:absolute; top:0; left:0; right:0; bottom:0; opacity:0.04; background-image:radial-gradient(#ffffff 1px, transparent 1px); background-size:24px 24px; pointer-events:none;"></div>
  
  <div class="container" style="position:relative; z-index:2;">
    <div style="max-width:860px; margin:0 auto; text-align:center;">
      
      <!-- Badge Identitas Resmi -->
      <div class="hero-badge">
        <i class="fas fa-certificate" style="color:var(--gold); font-size:13px;"></i>
        <span>Unit Pelaksana Teknis Pemasyarakatan</span>
      </div>

      <!-- Judul Utama -->
      <h1 class="hero-title">
        Balai Pemasyarakatan Kelas I Medan
      </h1>
      
      <p class="hero-desc">
        Pusat Layanan Wajib Lapor Klien Daring, Penelitian Kemasyarakatan (Litmas), dan Pendampingan Hukum Terintegrasi menuju Wilayah Bebas dari Korupsi (WBK).
      </p>

      <!-- Tombol Aksi Utama (Tinggi & Padding Seragam) -->
      <div class="hero-btn-group">
        <a href="/login" class="btn-hero btn-hero-primary">
          <i class="fas fa-clipboard-check"></i> Wajib Lapor Klien Online
        </a>
        <a href="/informasi?sub=alur-wajib-lapor" class="btn-hero btn-hero-secondary">
          <i class="fas fa-book-open"></i> Panduan & Alur Layanan
        </a>
        <a href="/profil" class="btn-hero btn-hero-secondary">
          <i class="fas fa-landmark"></i> Profil Institusi
        </a>
      </div>

      <!-- Banner Maklumat / Running Announcement -->
      <div class="hero-announcement">
        <span class="hero-announcement-badge">
          <i class="fas fa-bullhorn"></i> Pengumuman
        </span>
        <span style="font-size:13px; color:#e2e8f0; line-height:1.5;">
          <% if (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.teks_pengumuman) { %>
            <%= konfigurasi.teks_pengumuman %>
          <% } else { %>
            Layanan Wajib Lapor Online dibuka setiap tanggal <strong><%= (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.tanggal_mulai_input) ? konfigurasi.tanggal_mulai_input : 1 %> s/d <%= (typeof konfigurasi !== 'undefined' && konfigurasi && konfigurasi.tanggal_akhir_input) ? konfigurasi.tanggal_akhir_input : 15 %> setiap bulannya</strong>.
          <% } %> Seluruh proses bebas pungutan liar (Gratis Rp 0,-).
        </span>
      </div>

    </div>
  </div>
</section>

<!-- STATISTIK KINERJA TRANSPARAN -->
<section style="background:#ffffff; padding:45px 0; border-bottom:1px solid #e2e8f0;">
  <div class="container">
    <div class="stats-container">
      
      <div class="stat-card-box">
        <div class="stat-val" style="color:var(--primary);">1.280+</div>
